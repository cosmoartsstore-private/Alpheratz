<Page
    x:Class="Alpheratz.Features.Bootstrap.BootstrapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages"
    Background="{ThemeResource ABg}">

    <Grid Background="{ThemeResource ABg}">
        <StackPanel x:Name="SplashContent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Opacity="0">

            <!-- ロゴ -->
            <Image Source="ms-appx:///Assets/LogoText.png"
                   Stretch="Uniform"
                   MaxWidth="520"
                   HorizontalAlignment="Center"/>

            <StackPanel x:Name="StartupErrorPanel"
                        MaxWidth="520"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('BootstrapPage.startupFailedTitle')}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AText}"
                           TextAlignment="Center"/>
                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('BootstrapPage.startupFailedMessage')}"
                           FontSize="14"
                           Foreground="{ThemeResource ATextDim}"
                           TextWrapping="WrapWholeWords"
                           TextAlignment="Center"/>
                <Button Content="{x:Bind messages:MessageCatalog.getMsg('BootstrapPage.exit')}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- 画面下部の著作権表示 -->
        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('BootstrapPage.copyright')}"
                   FontSize="10"
                   Foreground="{ThemeResource ATextFaint}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,18"/>
    </Grid>
</Page>
