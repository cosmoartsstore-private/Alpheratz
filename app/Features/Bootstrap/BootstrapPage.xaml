<Page
    x:Class="Alpheratz.Features.Bootstrap.BootstrapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="{ThemeResource ABg}"
    Unloaded="Page_Unloaded">

    <Grid Background="{ThemeResource ABg}">
        <StackPanel x:Name="SplashContent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="28"
                    Opacity="0">

            <!-- ロゴ -->
            <Image Source="ms-appx:///Assets/LogoText.png"
                   Stretch="Uniform"
                   MaxWidth="520"
                   HorizontalAlignment="Center"/>

            <!-- 読み込み進捗に合わせて星を移動する。 -->
            <Grid Width="420" Height="28" HorizontalAlignment="Center">
                <Border Height="3" CornerRadius="1.5"
                        Background="{ThemeResource ABorder}"
                        VerticalAlignment="Center"/>
                <Border x:Name="ProgressFill"
                        Height="3" CornerRadius="1.5"
                        Background="{ThemeResource APrimary}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="0"/>
                <shared:AppIcon x:Name="StarIcon"
                                IconName="sparkle" IconSize="18"
                                Foreground="{ThemeResource APrimary}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-9,0,0,0">
                    <shared:AppIcon.RenderTransform>
                        <TranslateTransform x:Name="StarTranslate" X="0"/>
                    </shared:AppIcon.RenderTransform>
                </shared:AppIcon>
            </Grid>
        </StackPanel>

        <!-- 画面下部の著作権表示 -->
        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('BootstrapPage.copyright')}"
                   FontSize="10"
                   Foreground="{ThemeResource ATextFaint}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,18"/>
    </Grid>
</Page>
