<Page
    x:Class="Alpheratz.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="Transparent"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <Grid Background="Transparent" Tapped="Backdrop_Tapped">
        <Border MaxWidth="1400" MaxHeight="960" MinWidth="640" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="{StaticResource ARadiusModal}"
                Background="{ThemeResource ASurface}"
                BorderBrush="{ThemeResource ABorder}"
                BorderThickness="1"
                Tapped="ModalContent_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bar with title + close -->
                <Grid Grid.Row="0" Padding="32,22,18,12">
                    <TextBlock Text="設定" Style="{StaticResource HeadingTextStyle}"/>
                    <Button x:Name="CloseButtonOverlay" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="34" Height="34"
                            CornerRadius="{StaticResource ARadiusButton}"
                            Background="{ThemeResource ASurfaceSoft}"
                            BorderThickness="0"
                            AutomationProperties.Name="閉じる"
                            ToolTipService.ToolTip="設定を閉じる (Esc)"
                            Click="CloseButton_Click">
                        <shared:AppIcon IconName="close" IconSize="12" Foreground="{ThemeResource ATextDim}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="32,4,32,32"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="36">

                        <!-- ============ 全般設定 ============ -->
                        <StackPanel Spacing="22">
                            <TextBlock Text="全般" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Text="写真フォルダ 1st" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.PhotoFolderPath}" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="変更" Style="{StaticResource PrimaryButtonStyle}" Click="ChoosePrimaryFolder_Click"/>
                                        <Button Grid.Column="2" Content="リセット" Style="{StaticResource GhostButtonStyle}" Click="ResetPrimaryFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="写真フォルダ 2nd" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Settings.SecondaryPhotoFolderPath}" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="変更" Style="{StaticResource PrimaryButtonStyle}" Click="ChooseSecondaryFolder_Click"/>
                                        <Button Grid.Column="2" Content="リセット" Style="{StaticResource GhostButtonStyle}" Click="ResetSecondaryFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ログイン時に起動" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows ログイン時に Alpheratz を自動起動します。" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.StartupEnabled, Mode=TwoWay}" Toggled="StartupToggle_Toggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="テーマ" FontWeight="SemiBold"/>
                                    <TextBlock Text="アプリの外観テーマを切り替えます。" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="ライト" Style="{StaticResource GhostButtonStyle}" Click="ThemeLight_Click"/>
                                    <Button Content="ダーク" Style="{StaticResource GhostButtonStyle}" Click="ThemeDark_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="StellaRecord 連携" FontWeight="SemiBold"/>
                                    <TextBlock Text="StellaRecord のランチャーにこのアプリを登録します。" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="登録" Style="{StaticResource PrimaryButtonStyle}" Click="RegisterStellaRecord_Click"/>
                            </Grid>

                            <StackPanel Spacing="10">
                                <TextBlock Text="ワールド情報の一括解決" FontWeight="SemiBold"/>
                                <TextBlock Text="ワールドが不明な写真を、同じフォルダ内の類似写真と照合してワールド情報を復元します。適用前に1件ずつ確認できます。" Style="{StaticResource HintTextStyle}"/>
                                <Button Content="確認付きで解決" Style="{StaticResource PrimaryButtonStyle}" Click="StartWorldAnalysis_Click" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Border Padding="20"
                                    CornerRadius="{StaticResource ARadiusLg}"
                                    BorderBrush="{ThemeResource ABorder}"
                                    BorderThickness="1"
                                    Background="{ThemeResource ASurfaceSoft}">
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26">
                                        <Border.Background>
                                            <ImageBrush ImageSource="ms-appx:///Assets/avatar.jpg" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="CosmoArtsStore" FontSize="{StaticResource AFontSizeLg}" FontWeight="SemiBold"/>
                                        <TextBlock Text="by ぷらねっと" Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- separator -->
                        <Border Height="1" Background="{ThemeResource ABorderMid}" Opacity="0.6"/>

                        <!-- ============ タグマスタ ============ -->
                        <StackPanel Spacing="18">
                            <TextBlock Text="タグマスタ" Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="タグを追加する" Style="{StaticResource SubHeadingTextStyle}"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TagInputBox"
                                                 Text="{Binding TagMaster.TagDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="タグ名"
                                                 KeyDown="TagInput_KeyDown"/>
                                        <Button Grid.Column="1"
                                                Content="追加"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="AddTag_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="追加済みタグ" Style="{StaticResource SubHeadingTextStyle}"/>

                                    <Border x:Name="TagEmptyState"
                                            Padding="14,12"
                                            CornerRadius="{StaticResource ARadiusLg}"
                                            BorderBrush="{ThemeResource ABorderMid}"
                                            BorderThickness="1"
                                            Background="{ThemeResource ASurfaceSoft}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="タグマスタはまだありません。"
                                                   Foreground="{ThemeResource ATextFaint}"
                                                   FontSize="{StaticResource AFontSizeMd}"/>
                                    </Border>

                                    <ItemsControl x:Name="TagRepeater" ItemsSource="{Binding TagMaster.masterTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <shared:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8"
                                                        CornerRadius="{StaticResource ARadiusLg}"
                                                        BorderBrush="{ThemeResource ABorderMid}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource ASurfaceSoft}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource AFontSizeMd}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AText}"/>
                                                        <Button Content="削除"
                                                                Padding="10,4"
                                                                MinWidth="0" MinHeight="0"
                                                                CornerRadius="{StaticResource ARadiusMd}"
                                                                Background="{ThemeResource ADangerSoft}"
                                                                BorderBrush="{ThemeResource ADangerBorder}"
                                                                BorderThickness="1"
                                                                Foreground="{ThemeResource ADanger}"
                                                                FontSize="{StaticResource AFontSizeSm}"
                                                                FontWeight="SemiBold"
                                                                Click="DeleteTag_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- separator -->
                        <Border Height="1" Background="{ThemeResource ABorderMid}" Opacity="0.6"/>

                        <!-- ============ 投稿テンプレート ============ -->
                        <StackPanel Spacing="18">
                            <TextBlock Text="投稿テンプレート" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="280"/>
                                    <ColumnDefinition Width="0.9*" MinWidth="280"/>
                                </Grid.ColumnDefinitions>

                                <!-- Editor -->
                                <Border Grid.Column="0" Style="{StaticResource SectionCardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="EditorModeLabel"
                                                   Text="新規テンプレート"
                                                   Style="{StaticResource SubHeadingTextStyle}"/>
                                        <TextBox Text="{Binding Template.TweetTemplateDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="220"
                                                 FontFamily="{StaticResource AFontMono}"
                                                 FontSize="{StaticResource AFontSizeMd}"
                                                 PlaceholderText="例:&#x0a;World: {}{world-name}&#x0a;&#x0a;#VRChat_world紹介"/>
                                        <TextBlock Style="{StaticResource HintTextStyle}">
                                            <Run Text="使える置換: "/>
                                            <Run Text="{}{world-name}" Foreground="{ThemeResource APrimary}" FontFamily="{StaticResource AFontMono}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="CancelEditButton"
                                                    Content="キャンセル"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Click="CancelEdit_Click"/>
                                            <Button x:Name="SaveButton"
                                                    Content="登録"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="SaveTemplate_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Template list -->
                                <Border Grid.Column="1" Style="{StaticResource SectionCardBorderStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="登録済みテンプレート" Style="{StaticResource SubHeadingTextStyle}"/>
                                        <ItemsControl x:Name="TemplateList" ItemsSource="{Binding Template.tweetTemplates}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="10"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="14"
                                                            CornerRadius="{StaticResource ARadiusLg}"
                                                            BorderBrush="{ThemeResource ABorder}"
                                                            BorderThickness="1"
                                                            Background="{ThemeResource ASurfaceSoft}"
                                                            Loaded="TemplateCard_Loaded"
                                                            PointerPressed="TemplateCard_PointerPressed">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock x:Name="TemplateLabel"
                                                                           Text="テンプレート"
                                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                                <TextBlock Text="{Binding}"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="6"
                                                                           FontFamily="{StaticResource AFontMono}"
                                                                           FontSize="{StaticResource AFontSizeSm}"
                                                                           LineHeight="20"
                                                                           Foreground="{ThemeResource AText}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                                                <Button Content="編集"
                                                                        Style="{StaticResource GhostButtonStyle}"
                                                                        Padding="10,4"
                                                                        MinWidth="0" MinHeight="0"
                                                                        FontSize="{StaticResource AFontSizeSm}"
                                                                        Click="EditTemplate_Click"/>
                                                                <Button Content="削除"
                                                                        Padding="10,4"
                                                                        MinWidth="0" MinHeight="0"
                                                                        CornerRadius="{StaticResource ARadiusMd}"
                                                                        Background="{ThemeResource ADangerSoft}"
                                                                        BorderBrush="{ThemeResource ADangerBorder}"
                                                                        BorderThickness="1"
                                                                        Foreground="{ThemeResource ADanger}"
                                                                        FontSize="{StaticResource AFontSizeSm}"
                                                                        FontWeight="SemiBold"
                                                                        Click="DeleteTemplate_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
