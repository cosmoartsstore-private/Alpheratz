<Page
    x:Class="Alpheratz.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Alpheratz.Shared.Converters"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="Transparent"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ThumbnailSourceConverter x:Key="DuplicateThumbnailSourceConverter" DecodePixelWidth="144"/>
    </Page.Resources>
    <Grid Background="Transparent" Tapped="Backdrop_Tapped">
        <Border MaxWidth="1120" MaxHeight="820" MinWidth="0" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="{StaticResource ARadiusModal}"
                Background="{ThemeResource ASurface}"
                BorderBrush="{ThemeResource ABorder}"
                BorderThickness="1"
                Tapped="ModalContent_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- タイトルと閉じる操作 -->
                <Grid Grid.Row="0" Padding="20,15">
                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.title')}" Style="{StaticResource HeadingTextStyle}"/>
                    <Button x:Name="CloseButtonOverlay" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="34" Height="34"
                            CornerRadius="{StaticResource ARadiusButton}"
                            Background="{ThemeResource ASurfaceSoft}"
                            BorderThickness="0"
                            AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.closeAutomationName')}"
                            ToolTipService.ToolTip="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.closeTooltip')}"
                            Click="CloseButton_Click">
                        <shared:AppIcon IconName="close" IconSize="12" Foreground="{ThemeResource ATextDim}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="192"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{ThemeResource ABorder}"
                            BorderThickness="0,1,1,0"
                            Background="{ThemeResource ASurface}">
                        <StackPanel Padding="8,10" Spacing="4">
                            <Button x:Name="GeneralNavButton"
                                    Tag="general"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="settings" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.generalTitle')}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SimilarPhotosNavButton"
                                    Tag="similar"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="images" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.similarPhotosTitle')}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TagMasterNavButton"
                                    Tag="tags"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="tag" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.tagMasterTitle')}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TemplateNavButton"
                                    Tag="templates"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="template" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.templateTitle')}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CreditsNavButton"
                                    Tag="credits"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="globe" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.creditsTitle')}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  Padding="22,20,22,28"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="SettingsContentGrid" ColumnSpacing="0" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftSettingsColumn" Width="*"/>
                            <ColumnDefinition x:Name="RightSettingsColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 全般 -->
                        <StackPanel x:Name="GeneralSection" Grid.Row="0" Grid.Column="0" Spacing="22">
                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.generalTitle')}" Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Spacing="18">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.primaryPhotoFolderLabel')}" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border MinHeight="42" Padding="12,9"
                                                CornerRadius="{StaticResource ARadiusMd}"
                                                Background="{ThemeResource ASurfaceSoft}"
                                                BorderBrush="{ThemeResource ABorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Settings.PhotoFolderPath}"
                                                       Foreground="{ThemeResource ATextDim}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('common.change')}"
                                                AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.changePrimaryPhotoFolderAutomationName')}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ChoosePrimaryFolder_Click"/>
                                        <Button Grid.Column="2"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('common.reset')}"
                                                AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.resetPrimaryPhotoFolderAutomationName')}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Click="ResetPrimaryFolder_Click"/>
                                    </Grid>

                                </StackPanel>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.secondaryPhotoFolderLabel')}" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border MinHeight="42" Padding="12,9"
                                                CornerRadius="{StaticResource ARadiusMd}"
                                                Background="{ThemeResource ASurfaceSoft}"
                                                BorderBrush="{ThemeResource ABorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Settings.SecondaryPhotoFolderPath}"
                                                       Foreground="{ThemeResource ATextDim}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('common.change')}"
                                                AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.changeSecondaryPhotoFolderAutomationName')}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ChooseSecondaryFolder_Click"/>
                                        <Button Grid.Column="2"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('common.reset')}"
                                                AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.resetSecondaryPhotoFolderAutomationName')}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Click="ResetSecondaryFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <Grid MinHeight="58" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.startupLabel')}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.startupDescription')}" Style="{StaticResource HintTextStyle}" TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              Width="48"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              OnContent=""
                                              OffContent=""
                                              AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.startupLabel')}"
                                              IsOn="{Binding Settings.StartupEnabled, Mode=TwoWay}"
                                              Toggled="StartupToggle_Toggled"/>
                            </Grid>

                            <Grid MinHeight="58" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.openWorldLinkLabel')}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.openWorldLinkDescription')}" Style="{StaticResource HintTextStyle}" TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              Width="48"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              OnContent=""
                                              OffContent=""
                                              AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.openWorldLinkLabel')}"
                                              IsOn="{Binding Settings.OpenWorldLinkOnPost, Mode=TwoWay}"
                                              Toggled="OpenWorldOnPostToggle_Toggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.themeLabel')}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.themeDescription')}" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <Button x:Name="ThemeSwitchButton"
                                        Grid.Column="1"
                                        MinWidth="126"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource GhostButtonStyle}"
                                        FontWeight="Bold"
                                        Click="ThemeSwitch_Click"/>
                            </Grid>

                            <!-- TODO: StellaRecord の提供を再開するときに、この連携設定を再表示する。 -->
                            <!-- TODO: StellaRecordDB から既存写真のワールド情報を再取得する明示ボタンを追加する。
                                 通常スキャンでは再取得せず、利用者が実行した場合だけ処理する。 -->
                            <Grid Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.stellaRecordIntegrationLabel')}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.stellaRecordIntegrationDescription')}" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{x:Bind messages:MessageCatalog.getMsg('common.register')}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="RegisterStellaRecord_Click"/>
                            </Grid>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.photoUserDataBackupLabel')}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.photoUserDataBackupDescription')}"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="WrapWholeWords"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.photoUserDataRestoreDescription')}"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="WrapWholeWords"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="CreatePhotoUserDataBackupButton"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.createPhotoUserDataBackupButton')}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="CreatePhotoUserDataBackup_Click"/>
                                        <Button x:Name="RestorePhotoUserDataBackupButton"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.restorePhotoUserDataBackupButton')}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Click="RestorePhotoUserDataBackup_Click"/>
                                        <ProgressRing x:Name="PhotoUserDataBackupProgress"
                                                      Width="20"
                                                      Height="20"
                                                      IsActive="False"
                                                      Visibility="Collapsed"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.photoUserDataBackupWorking')}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- 類似写真の分析結果を利用する機能 -->
                        <StackPanel x:Name="SimilarPhotosSection"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="18"
                                    Visibility="Collapsed">
                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.similarPhotosTitle')}"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <Grid MinHeight="58" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.worldNameInferenceLabel')}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.worldNameInferenceDescription')}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   TextWrapping="WrapWholeWords"/>
                                        <StackPanel x:Name="WorldAnalysisProgressPanel"
                                                    Margin="0,7,0,0"
                                                    Spacing="5"
                                                    Visibility="Collapsed">
                                            <shared:WaveProgressBar x:Name="WorldAnalysisProgressBar"
                                                                    Minimum="0"
                                                                    Height="4"/>
                                            <TextBlock x:Name="WorldAnalysisProgressText"
                                                       Style="{StaticResource HintTextStyle}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WorldAnalysisProgressDetail"
                                                       Style="{StaticResource HintTextStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="StartWorldAnalysisButton"
                                            Grid.Column="1"
                                            Content="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.startWorldNameInferenceButton')}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="StartWorldAnalysis_Click"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.duplicatePhotosHeading')}"
                                               Style="{StaticResource SubHeadingTextStyle}"/>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.duplicatePhotosDescription')}"
                                                       TextWrapping="WrapWholeWords"/>
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.duplicatePhotosDeletionNotice')}"
                                                       Style="{StaticResource HintTextStyle}"
                                                       TextWrapping="WrapWholeWords"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{Binding DetectButtonText}"
                                                IsEnabled="{Binding CanDetect}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                VerticalAlignment="Center"
                                                Click="DetectDuplicatePhotos_Click"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing Width="20"
                                                      Height="20"
                                                      IsActive="{Binding IsBusy}"
                                                      AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.duplicatePhotosWorking')}"/>
                                        <TextBlock Text="{Binding ProgressText}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{ThemeResource ATextDim}"
                                               TextWrapping="WrapWholeWords"
                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.duplicatePhotosInitialGuidance')}"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="WrapWholeWords"
                                               Visibility="{Binding ShowInitialGuidance, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="12"
                                        Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding DetectionSummary}"
                                           FontWeight="SemiBold"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.duplicatePhotosSelectionGuidance')}"
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="WrapWholeWords"/>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12"
                                                    CornerRadius="{StaticResource ARadiusLg}"
                                                    Background="{ThemeResource ASurface}"
                                                    BorderBrush="{ThemeResource ABorder}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Padding="14,10"
                                                          Background="{ThemeResource ASurfaceSoft}">
                                                        <TextBlock Text="{Binding SummaryText}"
                                                                   FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Photos}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{ThemeResource ABorderSoft}"
                                                                        BorderThickness="0,1,0,0">
                                                                    <Grid Padding="12"
                                                                          ColumnSpacing="12"
                                                                          MinHeight="82">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="72"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  IsEnabled="{Binding IsSelectionEnabled}"
                                                                                  VerticalAlignment="Center"
                                                                                  AutomationProperties.Name="{Binding SelectionAutomationName}"/>
                                                                        <Border Grid.Column="1"
                                                                                Width="72"
                                                                                Height="56"
                                                                                CornerRadius="{StaticResource ARadiusSm}"
                                                                                Background="{ThemeResource ASurfaceSofter}"
                                                                                BorderBrush="{ThemeResource ABorder}"
                                                                                BorderThickness="1">
                                                                            <Image Source="{Binding PreviewPath, Converter={StaticResource DuplicateThumbnailSourceConverter}}"
                                                                                   Stretch="UniformToFill"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="2"
                                                                                    Spacing="3"
                                                                                    VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding PhotoFilename}"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding DirectoryPath}"
                                                                                       Style="{StaticResource HintTextStyle}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding DetailsText}"
                                                                                       FontFamily="{StaticResource AFontMono}"
                                                                                       FontSize="{StaticResource AFontSizeXs}"
                                                                                       Foreground="{ThemeResource ATextFaint}"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding RetentionLabel}"
                                                                                       FontSize="{StaticResource AFontSizeXs}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{ThemeResource ATextDim}"
                                                                                       Visibility="{Binding IsRequiredRetention, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectionSummary}"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="WrapWholeWords"
                                               VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <Button Grid.Column="1"
                                            Content="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.deleteSelectedDuplicatePhotosButton')}"
                                            IsEnabled="{Binding CanDeleteSelected}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            VerticalAlignment="Center"
                                            Click="DeleteDuplicatePhotos_Click"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- タグマスタ -->
                        <StackPanel x:Name="TagMasterSection" Grid.Row="2" Grid.Column="0" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.tagMasterTitle')}" Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.addTagHeading')}" Style="{StaticResource SubHeadingTextStyle}"/>
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TagInputBox"
                                                     Text="{Binding TagMaster.TagDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.tagNamePlaceholder')}"
                                                     MaxLength="25"
                                                     KeyDown="TagInput_KeyDown"/>
                                            <Button x:Name="AddTagButton"
                                                    Grid.Column="1"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('common.add')}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="AddTag_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="TagValidationText"
                                                   Visibility="Collapsed"
                                                   FontSize="{StaticResource AFontSizeSm}"
                                                   Foreground="{ThemeResource AWarn}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.savedTagsHeading')}" Style="{StaticResource SubHeadingTextStyle}"/>

                                    <Border x:Name="TagEmptyState"
                                            Padding="14,12"
                                            CornerRadius="{StaticResource ARadiusLg}"
                                            BorderBrush="{ThemeResource ABorderMid}"
                                            BorderThickness="1"
                                            Background="{ThemeResource ASurfaceSoft}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.noSavedTags')}"
                                                   Foreground="{ThemeResource ATextFaint}"
                                                   FontSize="{StaticResource AFontSizeMd}"/>
                                    </Border>

                                    <ItemsControl x:Name="TagRepeater" ItemsSource="{Binding TagMaster.masterTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <shared:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Padding="12,8"
                                                        CornerRadius="{StaticResource ARadiusLg}"
                                                        BorderBrush="{ThemeResource ABorderMid}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource ASurface}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource AFontSizeMd}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AText}"
                                                                   MaxWidth="420"
                                                                   TextWrapping="Wrap"/>
                                                        <Button Content="{x:Bind messages:MessageCatalog.getMsg('common.delete')}"
                                                                Style="{StaticResource DangerChipButtonStyle}"
                                                                Click="DeleteTag_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 投稿テンプレート -->
                        <StackPanel x:Name="TemplateSection" Grid.Row="3" Grid.Column="0" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.templateTitle')}" Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="EditorModeLabel"
                                               Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPageLogic.templateNewHeading')}"
                                               Style="{StaticResource SubHeadingTextStyle}"/>
                                    <TextBox x:Name="TemplateInputBox"
                                             Text="{Binding Template.TweetTemplateDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MaxLength="280"
                                             MinHeight="220"
                                             FontFamily="{StaticResource AFontMono}"
                                             FontSize="{StaticResource AFontSizeMd}"
                                             BeforeTextChanging="TemplateInputBox_BeforeTextChanging"
                                             PlaceholderText="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.templatePlaceholder')}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TemplateValidationText"
                                                   Visibility="Collapsed"
                                                   FontSize="{StaticResource AFontSizeSm}"
                                                   Foreground="{ThemeResource AWarn}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TemplateCharacterCountText"
                                                   Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   FontSize="{StaticResource AFontSizeSm}"
                                                   Foreground="{ThemeResource ATextFaint}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.quickTagsLabel')}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.worldNameQuickTag')}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                MinWidth="0"
                                                Padding="10,5"
                                                Click="InsertWorldNameToken_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="CancelEditButton"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('common.cancel')}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Visibility="Collapsed"
                                                Click="CancelEdit_Click"/>
                                        <Button x:Name="SaveButton"
                                                Content="{x:Bind messages:MessageCatalog.getMsg('common.register')}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="False"
                                                Click="SaveTemplate_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.savedTemplatesHeading')}" Style="{StaticResource SubHeadingTextStyle}"/>
                                    <ItemsControl x:Name="TemplateList" ItemsSource="{Binding Template.tweetTemplates}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Padding="14"
                                                        CornerRadius="{StaticResource ARadiusLg}"
                                                        BorderBrush="{ThemeResource ABorder}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource ASurface}"
                                                        Loaded="TemplateCard_Loaded"
                                                        PointerPressed="TemplateCard_PointerPressed">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock x:Name="TemplateLabel"
                                                                       Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPageLogic.templateInactiveLabel')}"
                                                                       Style="{StaticResource SectionTitleStyle}"/>
                                                            <TextBlock Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="6"
                                                                       FontFamily="{StaticResource AFontMono}"
                                                                       FontSize="{StaticResource AFontSizeSm}"
                                                                       LineHeight="20"
                                                                       Foreground="{ThemeResource AText}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                                            <Button Content="{x:Bind messages:MessageCatalog.getMsg('common.edit')}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    Padding="10,4"
                                                                    MinWidth="0" MinHeight="0"
                                                                    FontSize="{StaticResource AFontSizeSm}"
                                                                    Click="EditTemplate_Click"/>
                                                            <Button Content="{x:Bind messages:MessageCatalog.getMsg('common.delete')}"
                                                                    Padding="10,4"
                                                                    MinWidth="0" MinHeight="0"
                                                                    Style="{StaticResource DangerChipButtonStyle}"
                                                                    Click="DeleteTemplate_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- クレジット -->
                        <StackPanel x:Name="CreditsSection"
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Spacing="18"
                                    Visibility="Collapsed"
                                    MaxWidth="980">
                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.creditsTitle')}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Padding="26"
                                    CornerRadius="{StaticResource ARadius}"
                                    Background="{ThemeResource ASurface}"
                                    BorderBrush="{ThemeResource ABorder}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- プロフィール画像専用。使用素材の一覧には追加しない。 -->
                                        <Border Grid.Column="0"
                                                Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                Background="{ThemeResource ASurface}"
                                                BorderBrush="{ThemeResource ABorderMid}"
                                                BorderThickness="1">
                                            <Image Source="ms-appx:///Assets/avatar.jpg"
                                                   Stretch="UniformToFill"
                                                   Width="56"
                                                   Height="56"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.creatorBrand')}"
                                                       FontSize="{StaticResource AFontSizeXl}"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{ThemeResource AText}"/>
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.creatorName')}"
                                                       FontSize="{StaticResource AFontSizeSm}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ATextFaint}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1"
                                            Margin="0,16,0,14"
                                            Background="{ThemeResource ABorder}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <HyperlinkButton Grid.Column="0"
                                                         NavigateUri="https://lit.link/planet_vrc"
                                                         Padding="0"
                                                         HorizontalAlignment="Stretch">
                                            <StackPanel Padding="8,4"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.litLinkLabel')}"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AText}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="lit.link/planet_vrc"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <Border Grid.Column="1" Background="{ThemeResource ABorder}"/>

                                        <HyperlinkButton Grid.Column="2"
                                                         NavigateUri="https://x.com/planet_vrc"
                                                         Padding="0"
                                                         HorizontalAlignment="Stretch">
                                            <StackPanel Padding="8,4"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.xProfileLabel')}"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AText}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="@planet_vrc"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <Border Grid.Column="3" Background="{ThemeResource ABorder}"/>

                                        <HyperlinkButton Grid.Column="4"
                                                         NavigateUri="https://cosmo-arts-store.booth.pm/"
                                                         Padding="0"
                                                         HorizontalAlignment="Stretch">
                                            <StackPanel Padding="8,4"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.boothLabel')}"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AText}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="cosmo-arts-store.booth.pm"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </Grid>

                                    <Border Height="1"
                                            Margin="0,16,0,14"
                                            Background="{ThemeResource ABorder}"/>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.materialsHeading')}"
                                                   FontSize="{StaticResource AFontSizeMd}"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{ThemeResource AText}"/>
                                        <Grid RowSpacing="9" ColumnSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <shared:AppIcon Grid.Row="0"
                                                            IconName="grid"
                                                            IconSize="14"
                                                            Foreground="{ThemeResource ATextFaint}"
                                                            VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.uiIconsLabel')}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ATextDim}"/>
                                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('SettingsPage.bootstrapIconsCredit')}"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
