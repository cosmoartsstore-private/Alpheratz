<Page
    x:Class="Alpheratz.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="Transparent"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <Page.Resources>
        <ControlTemplate x:Key="ThemeSegmentButtonTemplate" TargetType="Button">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                AutomationProperties.AccessibilityView="Raw"/>
        </ControlTemplate>
    </Page.Resources>
    <Grid Background="Transparent" Tapped="Backdrop_Tapped">
        <Border MaxWidth="1120" MaxHeight="820" MinWidth="0" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="{StaticResource ARadiusModal}"
                Background="{ThemeResource ASurface}"
                BorderBrush="{ThemeResource ABorder}"
                BorderThickness="1"
                Tapped="ModalContent_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bar with title + close -->
                <Grid Grid.Row="0" Padding="20,15">
                    <TextBlock Text="設定" Style="{StaticResource HeadingTextStyle}"/>
                    <Button x:Name="CloseButtonOverlay" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="34" Height="34"
                            CornerRadius="{StaticResource ARadiusButton}"
                            Background="{ThemeResource ASurfaceSoft}"
                            BorderThickness="0"
                            AutomationProperties.Name="閉じる"
                            ToolTipService.ToolTip="設定を閉じる (Esc)"
                            Click="CloseButton_Click">
                        <shared:AppIcon IconName="close" IconSize="12" Foreground="{ThemeResource ATextDim}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="164"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{ThemeResource ABorder}"
                            BorderThickness="0,1,1,0"
                            Background="{ThemeResource ASurface}">
                        <StackPanel Padding="8,10" Spacing="4">
                            <Button x:Name="GeneralNavButton"
                                    Tag="general"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="settings" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="全般"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TagMasterNavButton"
                                    Tag="tags"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="tag" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="タグマスタ"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TemplateNavButton"
                                    Tag="templates"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="template" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="テンプレート"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CreditsNavButton"
                                    Tag="credits"
                                    Style="{StaticResource HeaderPillButtonStyle}"
                                    CornerRadius="{StaticResource ARadiusSm}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <shared:AppIcon IconName="globe" IconSize="15" Foreground="{ThemeResource ATextDim}"/>
                                    <TextBlock Text="クレジット"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  Padding="22,20,22,28"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="SettingsContentGrid" ColumnSpacing="0" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftSettingsColumn" Width="*"/>
                            <ColumnDefinition x:Name="RightSettingsColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ============ 全般設定 ============ -->
                        <StackPanel x:Name="GeneralSection" Grid.Row="0" Grid.Column="0" Spacing="22">
                            <TextBlock Text="全般" Style="{StaticResource SectionTitleStyle}"/>

                            <StackPanel Spacing="18">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="写真フォルダ 1st" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border MinHeight="42" Padding="12,9"
                                                CornerRadius="{StaticResource ARadiusMd}"
                                                Background="{ThemeResource ASurfaceSoft}"
                                                BorderBrush="{ThemeResource ABorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Settings.PhotoFolderPath}"
                                                       Foreground="{ThemeResource ATextDim}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="変更" Style="{StaticResource PrimaryButtonStyle}" Click="ChoosePrimaryFolder_Click"/>
                                        <Button Grid.Column="2" Content="リセット" Style="{StaticResource GhostButtonStyle}" Click="ResetPrimaryFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="写真フォルダ 2nd" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border MinHeight="42" Padding="12,9"
                                                CornerRadius="{StaticResource ARadiusMd}"
                                                Background="{ThemeResource ASurfaceSoft}"
                                                BorderBrush="{ThemeResource ABorder}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Settings.SecondaryPhotoFolderPath}"
                                                       Foreground="{ThemeResource ATextDim}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="変更" Style="{StaticResource PrimaryButtonStyle}" Click="ChooseSecondaryFolder_Click"/>
                                        <Button Grid.Column="2" Content="リセット" Style="{StaticResource GhostButtonStyle}" Click="ResetSecondaryFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <Grid MinHeight="58" ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ログイン時に起動" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows ログイン時に Alpheratz を自動起動します。" Style="{StaticResource HintTextStyle}" TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              Width="48"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              OnContent=""
                                              OffContent=""
                                              IsOn="{Binding Settings.StartupEnabled, Mode=TwoWay}"
                                              Toggled="StartupToggle_Toggled"/>
                            </Grid>

                            <Grid MinHeight="58" ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="投稿時にワールドリンクを開く" FontWeight="SemiBold"/>
                                    <TextBlock Text="投稿画面を開くとき、選択写真の VRChat ワールドリンクも開きます。" Style="{StaticResource HintTextStyle}" TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              MinWidth="0"
                                              Width="48"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              OnContent=""
                                              OffContent=""
                                              IsOn="{Binding Settings.OpenWorldLinkOnPost, Mode=TwoWay}"
                                              Toggled="OpenWorldOnPostToggle_Toggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="テーマ" FontWeight="SemiBold"/>
                                    <TextBlock Text="アプリの外観テーマを切り替えます。" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1"
                                      x:Name="ThemeSegment"
                                      Width="204"
                                      Height="40"
                                      Padding="4"
                                      VerticalAlignment="Center"
                                      Background="{ThemeResource ASurfaceSoft}"
                                      BorderBrush="{ThemeResource ABorder}"
                                      BorderThickness="1"
                                      CornerRadius="{StaticResource ARadiusMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ThemeSelectionPill"
                                            Grid.Column="0"
                                            CornerRadius="6"
                                            Background="{ThemeResource APrimary}"/>
                                    <Button x:Name="ThemeLightButton"
                                            Grid.Column="0"
                                            Content="ライト"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Foreground="{ThemeResource ATextDim}"
                                            FontSize="{StaticResource AFontSizeSm}"
                                            FontWeight="Bold"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="0"
                                            Template="{StaticResource ThemeSegmentButtonTemplate}"
                                            Click="ThemeLight_Click"/>
                                    <Button x:Name="ThemeDarkButton"
                                            Grid.Column="1"
                                            Content="ダーク"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Foreground="{ThemeResource ATextDim}"
                                            FontSize="{StaticResource AFontSizeSm}"
                                            FontWeight="Bold"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="0"
                                            Template="{StaticResource ThemeSegmentButtonTemplate}"
                                            Click="ThemeDark_Click"/>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="StellaRecord 連携" FontWeight="SemiBold"/>
                                    <TextBlock Text="StellaRecord のランチャーにこのアプリを登録します。" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="登録" Style="{StaticResource PrimaryButtonStyle}" Click="RegisterStellaRecord_Click"/>
                            </Grid>

                            <Grid MinHeight="58" ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="ワールド名不明の写真の推測" FontWeight="SemiBold"/>
                                    <TextBlock Text="ワールド名不明の写真を分析済みの写真から推測します。" Style="{StaticResource HintTextStyle}" TextWrapping="WrapWholeWords"/>
                                    <TextBlock x:Name="WorldAnalysisUnavailableHint"
                                               Text="類似画像解析が完了すると使用できます。"
                                               Style="{StaticResource HintTextStyle}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <Button x:Name="StartWorldAnalysisButton"
                                        Grid.Column="1"
                                        Content="分析"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="StartWorldAnalysis_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- ============ タグマスタ ============ -->
                        <StackPanel x:Name="TagMasterSection" Grid.Row="1" Grid.Column="0" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="タグマスタ" Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="タグを追加する" Style="{StaticResource SubHeadingTextStyle}"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TagInputBox"
                                                 Text="{Binding TagMaster.TagDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="タグ名"
                                                 KeyDown="TagInput_KeyDown"/>
                                        <Button Grid.Column="1"
                                                Content="追加"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="AddTag_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardBorderStyle}"
                                    Background="{ThemeResource ASurface}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="追加済みタグ" Style="{StaticResource SubHeadingTextStyle}"/>

                                    <Border x:Name="TagEmptyState"
                                            Padding="14,12"
                                            CornerRadius="{StaticResource ARadiusLg}"
                                            BorderBrush="{ThemeResource ABorderMid}"
                                            BorderThickness="1"
                                            Background="{ThemeResource ASurfaceSoft}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="タグマスタはまだありません。"
                                                   Foreground="{ThemeResource ATextFaint}"
                                                   FontSize="{StaticResource AFontSizeMd}"/>
                                    </Border>

                                    <ItemsControl x:Name="TagRepeater" ItemsSource="{Binding TagMaster.masterTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <shared:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8"
                                                        CornerRadius="{StaticResource ARadiusLg}"
                                                        BorderBrush="{ThemeResource ABorderMid}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource ASurface}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource AFontSizeMd}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AText}"
                                                                   MaxWidth="220"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Button Content="削除"
                                                                Style="{StaticResource DangerChipButtonStyle}"
                                                                Click="DeleteTag_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 投稿テンプレート ============ -->
                        <StackPanel x:Name="TemplateSection" Grid.Row="2" Grid.Column="0" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="投稿テンプレート" Style="{StaticResource SectionTitleStyle}"/>

                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="EditorModeLabel"
                                               Text="新規テンプレート"
                                               Style="{StaticResource SubHeadingTextStyle}"/>
                                    <TextBox Text="{Binding Template.TweetTemplateDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="220"
                                             FontFamily="{StaticResource AFontMono}"
                                             FontSize="{StaticResource AFontSizeMd}"
                                             PlaceholderText="例:&#x0a;World: {}{world-name}&#x0a;&#x0a;#VRChat_world紹介"/>
                                    <TextBlock Style="{StaticResource HintTextStyle}">
                                        <Run Text="使える置換: "/>
                                        <Run Text="{}{world-name}" Foreground="{ThemeResource APrimary}" FontFamily="{StaticResource AFontMono}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="CancelEditButton"
                                                Content="キャンセル"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Visibility="Collapsed"
                                                Click="CancelEdit_Click"/>
                                        <Button x:Name="SaveButton"
                                                Content="登録"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="SaveTemplate_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="登録済みテンプレート" Style="{StaticResource SubHeadingTextStyle}"/>
                                    <ItemsControl x:Name="TemplateList" ItemsSource="{Binding Template.tweetTemplates}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14"
                                                        CornerRadius="{StaticResource ARadiusLg}"
                                                        BorderBrush="{ThemeResource ABorder}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource ASurfaceSoft}"
                                                        Loaded="TemplateCard_Loaded"
                                                        PointerPressed="TemplateCard_PointerPressed">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock x:Name="TemplateLabel"
                                                                       Text="テンプレート"
                                                                       Style="{StaticResource SectionTitleStyle}"/>
                                                            <TextBlock Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="6"
                                                                       FontFamily="{StaticResource AFontMono}"
                                                                       FontSize="{StaticResource AFontSizeSm}"
                                                                       LineHeight="20"
                                                                       Foreground="{ThemeResource AText}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                                            <Button Content="編集"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    Padding="10,4"
                                                                    MinWidth="0" MinHeight="0"
                                                                    FontSize="{StaticResource AFontSizeSm}"
                                                                    Click="EditTemplate_Click"/>
                                                            <Button Content="削除"
                                                                    Padding="10,4"
                                                                    MinWidth="0" MinHeight="0"
                                                                    Style="{StaticResource DangerChipButtonStyle}"
                                                                    Click="DeleteTemplate_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ クレジット ============ -->
                        <StackPanel x:Name="CreditsSection"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Spacing="18"
                                    Visibility="Collapsed"
                                    MaxWidth="980">
                            <TextBlock Text="クレジット" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Padding="26"
                                    CornerRadius="{StaticResource ARadius}"
                                    Background="{ThemeResource ASurfaceSoft}"
                                    BorderBrush="{ThemeResource ABorder}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                Background="{ThemeResource ASurface}"
                                                BorderBrush="{ThemeResource ABorderMid}"
                                                BorderThickness="1">
                                            <Image Source="ms-appx:///Assets/avatar.jpg"
                                                   Stretch="UniformToFill"
                                                   Width="56"
                                                   Height="56"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <TextBlock Text="CosmoArtsStore"
                                                       FontSize="{StaticResource AFontSizeXl}"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{ThemeResource AText}"/>
                                            <TextBlock Text="Creator:ぷらねっと/planet"
                                                       FontSize="{StaticResource AFontSizeSm}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ATextFaint}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1"
                                            Margin="0,16,0,14"
                                            Background="{ThemeResource ABorder}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <HyperlinkButton Grid.Column="0"
                                                         NavigateUri="https://lit.link/planet_vrc"
                                                         Padding="0"
                                                         HorizontalAlignment="Stretch">
                                            <StackPanel Padding="8,4"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="Lit.Link"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AText}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="lit.link/planet_vrc"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <Border Grid.Column="1" Background="{ThemeResource ABorder}"/>

                                        <HyperlinkButton Grid.Column="2"
                                                         NavigateUri="https://x.com/planet_vrc"
                                                         Padding="0"
                                                         HorizontalAlignment="Stretch">
                                            <StackPanel Padding="8,4"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="X / Twitter"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AText}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="@planet_vrc"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <Border Grid.Column="3" Background="{ThemeResource ABorder}"/>

                                        <HyperlinkButton Grid.Column="4"
                                                         NavigateUri="https://cosmo-arts-store.booth.pm/"
                                                         Padding="0"
                                                         HorizontalAlignment="Stretch">
                                            <StackPanel Padding="8,4"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="BOOTH"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource AText}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="cosmo-arts-store.booth.pm"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </Grid>

                                    <Border Height="1"
                                            Margin="0,16,0,14"
                                            Background="{ThemeResource ABorder}"/>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="使用素材"
                                                   FontSize="{StaticResource AFontSizeMd}"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{ThemeResource AText}"/>
                                        <Grid RowSpacing="9" ColumnSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <shared:AppIcon Grid.Row="0"
                                                            IconName="photo"
                                                            IconSize="14"
                                                            Foreground="{ThemeResource ATextFaint}"
                                                            VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock Text="プロフィール画像"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ATextDim}"/>
                                                <TextBlock Text="CosmoArtsStore"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"/>
                                            </StackPanel>

                                            <shared:AppIcon Grid.Row="1"
                                                            IconName="grid"
                                                            IconSize="14"
                                                            Foreground="{ThemeResource ATextFaint}"
                                                            VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock Text="UIアイコン"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ATextDim}"/>
                                                <TextBlock Text="Bootstrap Icons / MIT License / Copyright (c) 2019-2024 The Bootstrap Authors"
                                                           FontSize="{StaticResource AFontSizeXs}"
                                                           Foreground="{ThemeResource ATextFaint}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
