<Page
    x:Class="Alpheratz.Features.WorldResolve.WorldResolvePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Alpheratz.Shared.Converters"
    xmlns:local="using:Alpheratz.Features.WorldResolve"
    Background="Transparent"
    IsTabStop="True"
    KeyDown="Page_KeyDown">
    <Page.Resources>
        <converters:ThumbnailSourceConverter x:Key="ThumbConverter" DecodePixelWidth="120"/>
        <converters:ThumbnailSourceConverter x:Key="PickerThumbConverter" DecodePixelWidth="160"/>
    </Page.Resources>

    <Grid Background="Transparent" Tapped="Backdrop_Tapped">
        <Border MaxWidth="1200" MinWidth="600" Margin="32"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="{StaticResource ARadiusModal}"
                Background="{ThemeResource ASurface}"
                BorderBrush="{ThemeResource ABorder}"
                BorderThickness="1"
                Tapped="ModalContent_Tapped">

            <Grid>
                <!-- === Main View === -->
                <Grid x:Name="MainView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="28,24,28,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ワールド解決" FontSize="{StaticResource AFontSize2Xl}" FontWeight="ExtraBold" Foreground="{ThemeResource AText}"/>
                            <TextBlock x:Name="StatusText" FontSize="{StaticResource AFontSizeSm}" Foreground="{ThemeResource ATextFaint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="全て適用" Style="{StaticResource GhostButtonStyle}" Click="ApplyAll_Click"/>
                            <Button Content="全てスキップ" Style="{StaticResource GhostButtonStyle}" Click="SkipAll_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- List -->
                    <ListView Grid.Row="1" x:Name="ItemsListView"
                              SelectionMode="None" Padding="16,0,16,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:WorldResolveItem">
                                <Border Padding="12" CornerRadius="{StaticResource ARadiusMd}"
                                        Background="{ThemeResource ASurfaceSoft}"
                                        BorderBrush="{ThemeResource ABorder}" BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Target photo -->
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <Border Height="80" CornerRadius="{StaticResource ARadiusSm}" Background="{ThemeResource ABorder}">
                                                <Image Source="{x:Bind TargetThumbPath, Mode=OneWay, Converter={StaticResource ThumbConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind TargetPhotoFilename}" FontSize="10"
                                                       Foreground="{ThemeResource ATextFaint}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Arrow + world info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Padding="8,0">
                                            <TextBlock Text="→" FontSize="{StaticResource AFontSizeXl}" HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource ATextFaint}"/>
                                            <TextBlock Text="{x:Bind MatchWorldName, Mode=OneWay}" FontSize="{StaticResource AFontSizeMd}"
                                                       FontWeight="SemiBold" Foreground="{ThemeResource AText}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       HorizontalAlignment="Center"/>
                                            <Border Padding="8,3" CornerRadius="{StaticResource ARadiusSm}" HorizontalAlignment="Center"
                                                    Background="{ThemeResource APrimarySoft}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource APrimary}"
                                                           HorizontalAlignment="Center">
                                                    <Run Text="距離: "/><Run Text="{x:Bind MatchDistance, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Match photo + select different -->
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <Border Height="80" CornerRadius="{StaticResource ARadiusSm}" Background="{ThemeResource ABorder}">
                                                <Image Source="{x:Bind MatchThumbPath, Mode=OneWay, Converter={StaticResource ThumbConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <HyperlinkButton Content="別を選ぶ" FontSize="10" Padding="0"
                                                             HorizontalAlignment="Center"
                                                             Click="OpenCandidatePicker_Click"
                                                             Tag="{x:Bind}"/>
                                        </StackPanel>

                                        <!-- Apply toggle -->
                                        <ToggleButton Grid.Column="3" VerticalAlignment="Center"
                                                      IsChecked="{x:Bind IsApplied, Mode=OneWay}"
                                                      Click="ToggleApply_Click" Tag="{x:Bind}"
                                                      MinWidth="64" MinHeight="32">
                                            <TextBlock Text="適用" FontSize="{StaticResource AFontSizeSm}"/>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="解決が必要な写真はありません" FontSize="{StaticResource AFontSizeLg}"
                                   Foreground="{ThemeResource ATextFaint}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Padding="28,16,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ApplyCountText" FontSize="{StaticResource AFontSizeSm}" Foreground="{ThemeResource ATextFaint}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="ApplyConfirmedBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyConfirmed_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="閉じる" Style="{StaticResource GhostButtonStyle}"
                                Click="Close_Click"/>
                    </Grid>

                    <!-- Loading -->
                    <Grid Grid.RowSpan="3" x:Name="LoadingOverlay"
                          Background="{ThemeResource ASurface}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="40" Height="40"/>
                            <TextBlock Text="候補を検索中..." FontSize="{StaticResource AFontSizeMd}" Foreground="{ThemeResource ATextFaint}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- === Candidate Picker View === -->
                <Grid x:Name="CandidatePickerView" Visibility="Collapsed" Background="{ThemeResource ASurface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Picker header -->
                    <Grid Grid.Row="0" Padding="28,24,28,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="← 戻る" Style="{StaticResource GhostButtonStyle}"
                                Click="BackFromPicker_Click" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="80" Height="60" CornerRadius="{StaticResource ARadiusSm}"
                                Background="{ThemeResource ABorder}" Margin="16,0,16,0">
                            <Image x:Name="PickerTargetImage" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PickerTargetFilename" FontSize="{StaticResource AFontSizeMd}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="類似度順で表示しています。クリックで選択。" FontSize="{StaticResource AFontSizeXs}"
                                       Foreground="{ThemeResource ATextFaint}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Candidate list -->
                    <ListView Grid.Row="1" x:Name="CandidateListView"
                              SelectionMode="None" Padding="16,0,16,16">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CandidateEntry">
                                <Border Padding="12" CornerRadius="{StaticResource ARadiusMd}"
                                        Background="{ThemeResource ASurfaceSoft}"
                                        BorderBrush="{ThemeResource ABorder}" BorderThickness="1"
                                        Tapped="CandidateItem_Tapped" Tag="{x:Bind}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Height="80" CornerRadius="{StaticResource ARadiusSm}"
                                                Background="{ThemeResource ABorder}">
                                            <Image Source="{x:Bind PhotoPath, Converter={StaticResource PickerThumbConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind WorldName}" FontSize="{StaticResource AFontSizeLg}" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AText}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind PhotoFilename}" FontSize="10"
                                                       Foreground="{ThemeResource ATextFaint}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Padding="8,3" CornerRadius="{StaticResource ARadiusSm}"
                                                Background="{ThemeResource APrimarySoft}" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource APrimary}">
                                                <Run Text="距離: "/><Run Text="{x:Bind Distance}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Candidate loading -->
                    <Grid Grid.RowSpan="2" x:Name="CandidateLoadingOverlay" Visibility="Collapsed"
                          Background="{ThemeResource ASurface}">
                        <ProgressRing IsActive="True" Width="40" Height="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
