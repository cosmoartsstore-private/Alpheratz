<Page
    x:Class="Alpheratz.Features.Gallery.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:galleryControls="using:Alpheratz.Features.Gallery.Controls"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="{ThemeResource ASurface}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Background="{ThemeResource ASurface}">

        <!-- Main column: stage + bulk operation bar -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <galleryControls:GalleryGridStage x:Name="GridStage"/>

            <Border x:Name="BulkOpBar" Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Margin="16,0,16,16"
                    Padding="12,9"
                    MaxWidth="760"
                    CornerRadius="{StaticResource ARadiusPill}"
                    BorderBrush="{ThemeResource ABorderMid}"
                    BorderThickness="1"
                    Background="{ThemeResource ASurface}">
                <shared:WrapPanel HorizontalSpacing="8" VerticalSpacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionCountLabel"
                                   VerticalAlignment="Center"
                                   FontWeight="ExtraBold"
                                   Foreground="{ThemeResource AText}"/>
                        <Button Content="選択解除" Style="{StaticResource GhostButtonStyle}" Click="ExitMultiSelect_Click"/>
                        <Button Content="&#x2665; 追加" Style="{StaticResource GhostButtonStyle}" Click="BulkFavorite_Click"/>
                        <Button Content="&#x2665; 解除" Style="{StaticResource GhostButtonStyle}" Click="BulkUnfavorite_Click"/>
                        <ComboBox x:Name="BulkTagCombo" PlaceholderText="タグを追加..." MinWidth="160"
                                  SelectionChanged="BulkTagCombo_SelectionChanged"/>
                        <Button Content="コピー" Style="{StaticResource GhostButtonStyle}" Click="BulkCopy_Click"/>
                </shared:WrapPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
