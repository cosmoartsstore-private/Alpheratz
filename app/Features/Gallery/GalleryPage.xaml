<Page
    x:Class="Alpheratz.Features.Gallery.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:galleryControls="using:Alpheratz.Features.Gallery.Controls"
    Background="{ThemeResource ASurface}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Background="{ThemeResource ASurface}">

        <!-- Main column: stage + bulk operation bar -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <galleryControls:GalleryGridStage x:Name="GridStage"/>

            <Border x:Name="BulkOpBar" Grid.Row="1"
                    Visibility="Collapsed"
                    Padding="14,10"
                    BorderBrush="{ThemeResource ABorder}"
                    BorderThickness="0,1,0,0"
                    Background="{ThemeResource ASurfaceSoft}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionCountLabel" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Content="選択解除" Style="{StaticResource GhostButtonStyle}" Click="ExitMultiSelect_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="&#x2665; 追加" Style="{StaticResource GhostButtonStyle}" Click="BulkFavorite_Click"/>
                        <Button Content="&#x2665; 解除" Style="{StaticResource GhostButtonStyle}" Click="BulkUnfavorite_Click"/>
                        <ComboBox x:Name="BulkTagCombo" PlaceholderText="タグを追加..." MinWidth="160"
                                  SelectionChanged="BulkTagCombo_SelectionChanged"/>
                        <Button Content="コピー" Style="{StaticResource GhostButtonStyle}" Click="BulkCopy_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FilterPanel is hosted by ShellPage overlay -->
        <galleryControls:GalleryFilterPanel x:Name="FilterPanel" Visibility="Collapsed"/>
    </Grid>
</Page>
