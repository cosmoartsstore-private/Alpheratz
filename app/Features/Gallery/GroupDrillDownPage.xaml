<UserControl
    x:Class="Alpheratz.Features.Gallery.GroupDrillDownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Grid Background="{ThemeResource ASurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12" Background="{ThemeResource ASurfaceSoft}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0"
                    Click="BackButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="8,6" Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="戻る" FontSize="{StaticResource AFontSizeMd}" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="GroupTitle" Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource AFontSizeLg}" FontWeight="Bold"
                       Foreground="{ThemeResource AText}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="1">
            <shared:PhotoGrid x:Name="PhotoGridControl"/>
            <shared:EmptyState x:Name="EmptyStateControl" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
