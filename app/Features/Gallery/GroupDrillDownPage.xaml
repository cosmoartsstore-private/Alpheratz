<UserControl
    x:Class="Alpheratz.Features.Gallery.GroupDrillDownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    IsTabStop="True"
    KeyDown="UserControl_KeyDown">
    <Grid Background="Transparent" Tapped="Backdrop_Tapped">
        <Border MaxWidth="1400" MaxHeight="900" MinWidth="640" Margin="40"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="{StaticResource ARadiusModal}"
                Background="{ThemeResource ASurface}"
                BorderBrush="{ThemeResource ABorder}"
                BorderThickness="1"
                Tapped="ModalContent_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: title + close button -->
                <Grid Grid.Row="0" Padding="24,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GroupTitle" Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource AFontSizeXl}" FontWeight="Bold"
                               Foreground="{ThemeResource AText}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseButton" Grid.Column="1"
                            Width="34" Height="34"
                            CornerRadius="{StaticResource ARadiusButton}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource ABorder}" BorderThickness="1"
                            AutomationProperties.Name="閉じる"
                            ToolTipService.ToolTip="グループ表示を閉じる (Esc)"
                            Click="CloseButton_Click">
                        <shared:AppIcon IconName="close" IconSize="12" Foreground="{ThemeResource ATextDim}"/>
                    </Button>
                </Grid>

                <!-- Body: photo grid -->
                <Grid Grid.Row="1">
                    <shared:PhotoGrid x:Name="PhotoGridControl"/>
                    <shared:EmptyState x:Name="EmptyStateControl" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
