<UserControl
    x:Class="Alpheratz.Features.Gallery.GroupDrillDownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Alpheratz.Shared.Converters">
    <UserControl.Resources>
        <converters:ThumbnailSourceConverter x:Key="DrillDownThumbConverter" DecodePixelWidth="260"/>
    </UserControl.Resources>
    <Grid Background="{ThemeResource ASurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12" Background="{ThemeResource ASurfaceSoft}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0"
                    Click="BackButton_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="8,6" Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="戻る" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="GroupTitle" Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{ThemeResource AText}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <GridView x:Name="PhotoItems" Grid.Row="1"
                  IsItemClickEnabled="True"
                  ItemClick="PhotoItems_ItemClick"
                  SelectionMode="None"
                  Padding="10"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="GridView_SizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   x:Name="PhotoItemsWrapGrid"
                                   Loaded="PhotoItemsWrapGrid_Loaded"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4,4,6">
                        <Border Style="{StaticResource PhotoCardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="7*"/>
                                    <RowDefinition Height="4*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Background="{ThemeResource ASurfaceSoft}">
                                    <Image Source="{Binding EffectiveSourcePath, Converter={StaticResource DrillDownThumbConverter}}"
                                           Stretch="UniformToFill" Opacity="0"
                                           ImageOpened="ThumbImage_ImageOpened"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="11,9,11,11" Spacing="3">
                                    <TextBlock Text="{Binding WorldName}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{ThemeResource AText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Timestamp}"
                                               FontFamily="{StaticResource AFontMono}"
                                               FontSize="11"
                                               Foreground="{ThemeResource ATextDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,4,4,0"
                                                        Padding="7,2"
                                                        CornerRadius="999"
                                                        Background="{ThemeResource AAccentSoft}"
                                                        BorderBrush="{ThemeResource ABorderStrong}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{ThemeResource APrimary}"
                                                               FontSize="10"
                                                               FontWeight="ExtraBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>
