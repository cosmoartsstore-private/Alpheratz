<UserControl
    x:Class="Alpheratz.Features.Gallery.Controls.GalleryGridStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:galleryControls="using:Alpheratz.Features.Gallery.Controls"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Grid Background="{ThemeResource ASurface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="MonthNavColumn" Width="56"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <shared:PhotoGrid x:Name="PhotoGridControl"/>
            <!--
                MasonryView は ViewMode.gallery のときだけ実体化したいので x:Load=False で
                初期化を遅延する。SetMasonryActive(true) 時に FindName で初めて生成される。
            -->
            <galleryControls:GalleryMasonryView x:Name="MasonryViewControl"
                                                x:Load="False"
                                                HorizontalAlignment="Stretch" Visibility="Collapsed"/>
            <shared:EmptyState x:Name="EmptyStateControl" Visibility="Collapsed"/>

            <!-- 上端の直線バーと状態文言で、写真一覧の読み込み中であることを示す。 -->
            <Grid x:Name="LoadingVeil" Visibility="Collapsed"
                  Background="{ThemeResource ASurfaceVeil}"
                  IsHitTestVisible="False">
                <shared:WaveProgressBar Height="3"
                                        VerticalAlignment="Top"
                                        IsIndeterminate="True"/>
                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryGridStage.loadingPhotos')}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource ATextDim}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <galleryControls:MonthNav x:Name="MonthNavControl" Grid.Column="1"/>
    </Grid>
</UserControl>
