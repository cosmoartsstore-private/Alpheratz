<UserControl
    x:Class="Alpheratz.Features.Gallery.Controls.GalleryFilterSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages">
    <Border Style="{StaticResource SidebarBorderStyle}">
        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterSidebar.heading')}"
                   FontSize="{StaticResource AFontSizeLg}"
                   FontWeight="ExtraBold"/>
    </Border>
</UserControl>
