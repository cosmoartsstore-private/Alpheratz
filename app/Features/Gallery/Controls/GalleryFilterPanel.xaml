<UserControl
    x:Class="Alpheratz.Features.Gallery.Controls.GalleryFilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="FilterPanelCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{ThemeResource AFilterPanelBackground}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AFilterPanelSectionLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="FilterPanelCardSectionStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,14"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="FilterPanelRoot"
            Background="{ThemeResource AFilterPanelBackground}"
            BorderBrush="{ThemeResource AFilterPanelBorder}"
            BorderThickness="0,0,1,0"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 見出し -->
            <Border x:Name="FilterPanelHeader"
                    Grid.Row="0"
                    Padding="14,12"
                    BorderBrush="{ThemeResource AFilterPanelBorder}"
                    BorderThickness="0,0,0,1"
                    Background="{ThemeResource AFilterPanelBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.heading')}"
                                   FontSize="{StaticResource AFontSizeLg}"
                                   FontWeight="ExtraBold"/>
                        <Border x:Name="BadgeBorder" Visibility="Collapsed"
                                Background="{ThemeResource APrimary}" CornerRadius="{StaticResource ARadiusPill}"
                                MinWidth="20" Height="20" Padding="6,0">
                            <TextBlock x:Name="BadgeText" FontSize="{StaticResource AFontSizeXs}" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{x:Bind messages:MessageCatalog.getMsg('common.reset')}"
                            Style="{StaticResource GhostButtonStyle}"
                            FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" Click="ResetFilters_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0" Spacing="0">

                    <!-- 表示順 -->
                    <Border Style="{StaticResource FilterPanelCardStyle}" Tag="FilterPanelCard">
                        <Border Style="{StaticResource FilterPanelCardSectionStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.sortHeading')}"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SortDateBtn"
                                            Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.sortNewest')}"
                                            Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource AFontSizeSm}" FontWeight="ExtraBold"
                                            HorizontalAlignment="Stretch" MinHeight="42" Click="SortDate_Click"/>
                                    <Button x:Name="SortWorldBtn" Grid.Column="1"
                                            Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.sortWorldName')}"
                                            Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource AFontSizeSm}" FontWeight="ExtraBold"
                                            HorizontalAlignment="Stretch" MinHeight="42" Click="SortWorld_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 撮影日 -->
                    <Border Style="{StaticResource FilterPanelCardStyle}" Tag="FilterPanelCard">
                        <Border Style="{StaticResource FilterPanelCardSectionStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.dateHeading')}"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="DateTriggerBtn" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="10,8" CornerRadius="{StaticResource ARadiusMd}" Click="DateTrigger_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="24" Height="24" CornerRadius="{StaticResource ARadiusSm}"
                                                    Background="{ThemeResource ASurfaceSofter}">
                                                <shared:AppIcon IconName="calendarRange"
                                                                IconSize="13"
                                                                Foreground="{ThemeResource ATextFaint}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="DateRangeLabel"
                                                           Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.allDates')}"
                                                           FontSize="{StaticResource AFontSizeMd}"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource ATextDim}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DateClearBtn" Grid.Column="1" Content="×" Visibility="Collapsed"
                                            AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.clearDateFilter')}"
                                            Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold"
                                            MinWidth="42" Click="DateClear_Click"/>
                                </Grid>

                                <Border x:Name="DatePickerPopup" Visibility="Collapsed"
                                        Background="{ThemeResource ASurface}" CornerRadius="{StaticResource ARadiusXl}"
                                        BorderBrush="{ThemeResource ABorder}" BorderThickness="1">
                                    <StackPanel>
                                        <Border Padding="12,10" BorderBrush="{ThemeResource ABorder}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <shared:AppIcon IconName="calendarRange" IconSize="14" Foreground="{ThemeResource ATextFaint}"/>
                                                    <TextBlock x:Name="CalendarRangeLabel"
                                                               Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.allDates')}"
                                                               FontSize="{StaticResource AFontSizeSm}"
                                                               Foreground="{ThemeResource ATextFaint}"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.dateRangeGuidance')}"
                                                           FontSize="{StaticResource AFontSizeSm}"
                                                           Foreground="{ThemeResource ATextFaint}"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnSpacing="6" Padding="10,8,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="FromChipBtn" Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" CornerRadius="{StaticResource ARadiusMd}" MinHeight="38" Click="FromChip_Click">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.startDate')}"
                                                               FontSize="{StaticResource AFontSizeXs}"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{ThemeResource ATextFaint}"/>
                                                    <TextBlock x:Name="FromValueText"
                                                               Text="{x:Bind messages:MessageCatalog.getMsg('common.emptyMarker')}"
                                                               FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold"
                                                               FontFamily="{StaticResource AFontMono}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ToChipBtn" Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" CornerRadius="{StaticResource ARadiusMd}" MinHeight="38" Click="ToChip_Click">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.endDate')}"
                                                               FontSize="{StaticResource AFontSizeXs}"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{ThemeResource ATextFaint}"/>
                                                    <TextBlock x:Name="ToValueText"
                                                               Text="{x:Bind messages:MessageCatalog.getMsg('common.emptyMarker')}"
                                                               FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold"
                                                               FontFamily="{StaticResource AFontMono}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnSpacing="6" RowSpacing="6" Padding="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button x:Name="PresetTodayBtn"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.presetToday')}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" MinHeight="38" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                    Click="PresetToday_Click"/>
                                            <Button x:Name="PresetLast7Btn" Grid.Column="1"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.presetLast7Days')}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" MinHeight="38" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                    Click="PresetLast7Days_Click"/>
                                            <Button x:Name="PresetThisMonthBtn" Grid.Row="1"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.presetThisMonth')}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" MinHeight="38" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                    Click="PresetThisMonth_Click"/>
                                            <Button x:Name="PresetLastMonthBtn" Grid.Row="1" Grid.Column="1"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.presetLastMonth')}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" MinHeight="38" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                    Click="PresetLastMonth_Click"/>
                                            <Button x:Name="PresetHalfYearBtn" Grid.Row="2"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.presetLastSixMonths')}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" MinHeight="38" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                    Click="PresetHalfYear_Click"/>
                                            <Button x:Name="PresetOneYearBtn" Grid.Row="2" Grid.Column="1"
                                                    Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.presetLastYear')}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    HorizontalAlignment="Stretch" MinHeight="38" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                    Click="PresetOneYear_Click"/>
                                        </Grid>

                                        <Border Padding="8,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="MonthPrevBtn" Content="‹"
                                                            AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.previousMonth')}"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            MinWidth="34" MinHeight="34" Padding="0" CornerRadius="{StaticResource ARadiusMd}" Click="MonthPrev_Click"/>
                                                    <TextBlock x:Name="MonthLabel" Grid.Column="1" FontSize="{StaticResource AFontSizeMd}" FontWeight="ExtraBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Button x:Name="MonthNextBtn" Grid.Column="2" Content="›"
                                                            AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.nextMonth')}"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            MinWidth="34" MinHeight="34" Padding="0" CornerRadius="{StaticResource ARadiusMd}" Click="MonthNext_Click"/>
                                                </Grid>
                                                <Grid x:Name="WeekdayHeaderGrid" Margin="0,4,0,2"/>
                                                <Grid x:Name="CalendarDayGrid"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="12,10" BorderBrush="{ThemeResource ABorder}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="{x:Bind messages:MessageCatalog.getMsg('common.clear')}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        MinWidth="92" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                        Click="CalendarClear_Click"/>
                                                <Button Grid.Column="2"
                                                        Content="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.applyDateRange')}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        MinWidth="92" FontSize="{StaticResource AFontSizeSm}" FontWeight="Bold" CornerRadius="{StaticResource ARadiusMd}"
                                                        Click="CalendarApply_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 向き -->
                    <Border Style="{StaticResource FilterPanelCardStyle}" Tag="FilterPanelCard">
                        <Border Style="{StaticResource FilterPanelCardSectionStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.orientationHeading')}"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OrientationAllBtn" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch" MinHeight="62" CornerRadius="{StaticResource ARadiusMd}" Click="OrientationAll_Click">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <shared:AppIcon x:Name="OrientationAllIcon"
                                                            IconName="images"
                                                            IconSize="16"
                                                            HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.orientationAll')}"
                                                       FontSize="{StaticResource AFontSizeXs}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OrientationLandscapeBtn" Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch" MinHeight="62" CornerRadius="{StaticResource ARadiusMd}" Click="OrientationLandscape_Click">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <shared:AppIcon x:Name="OrientationLandscapeIcon"
                                                            IconName="landscape"
                                                            IconSize="17"
                                                            HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.orientationLandscape')}"
                                                       FontSize="{StaticResource AFontSizeXs}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OrientationPortraitBtn" Grid.Column="2" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch" MinHeight="62" CornerRadius="{StaticResource ARadiusMd}" Click="OrientationPortrait_Click">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <shared:AppIcon x:Name="OrientationPortraitIcon"
                                                            IconName="portrait"
                                                            IconSize="17"
                                                            HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.orientationPortrait')}"
                                                       FontSize="{StaticResource AFontSizeXs}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- タグ / ワールド -->
                    <Border Style="{StaticResource FilterPanelCardStyle}" Tag="FilterPanelCard">
                        <StackPanel>
                            <Border Style="{StaticResource FilterPanelCardSectionStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.tagHeading')}"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <Button x:Name="TagTriggerBtn" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="10,8" CornerRadius="{StaticResource ARadiusMd}" Click="TagTrigger_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="{StaticResource ARadiusSm}"
                                                    BorderBrush="{ThemeResource ABorder}" BorderThickness="1"
                                                    Background="{ThemeResource ASurface}">
                                                <shared:AppIcon IconName="tag"
                                                                IconSize="13"
                                                                Foreground="{ThemeResource ATextFaint}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0,0,0">
                                                <TextBlock x:Name="TagSummaryLabel"
                                                           Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.allTags')}"
                                                           FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"
                                                           Foreground="{ThemeResource ATextDim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <shared:AppIcon Grid.Column="2"
                                                            IconName="chevronDown"
                                                            IconSize="12"
                                                            Foreground="{ThemeResource ATextFaint}"
                                                            VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="TagDropdownPanel" Visibility="Collapsed"
                                            Background="{ThemeResource ASurface}" CornerRadius="{StaticResource ARadiusXl}"
                                            BorderBrush="{ThemeResource ABorder}" BorderThickness="1">
                                        <StackPanel>
                                            <Border Padding="10,8" BorderBrush="{ThemeResource ABorder}" BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <shared:AppIcon IconName="search"
                                                                    IconSize="14"
                                                                    Foreground="{ThemeResource ATextFaint}"
                                                                    VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TagSearchBox" Grid.Column="1"
                                                             PlaceholderText="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.tagSearchPlaceholder')}"
                                                             BorderThickness="0" Background="Transparent" Padding="0"
                                                             FontSize="{StaticResource AFontSizeMd}" HorizontalAlignment="Stretch"
                                                             TextChanged="TagSearch_TextChanged"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="TagCheckboxList" Spacing="2" Padding="4"/>
                                            </ScrollViewer>
                                            <Border Padding="8,6" BorderBrush="{ThemeResource ABorder}" BorderThickness="0,1,0,0">
                                                <TextBlock x:Name="TagCountLabel" FontSize="{StaticResource AFontSizeXs}" Foreground="{ThemeResource ATextFaint}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{ThemeResource AFilterPanelBorder}" Tag="FilterPanelDivider"/>

                            <Border Style="{StaticResource FilterPanelCardSectionStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.worldHeading')}"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <Button x:Name="WorldTriggerBtn" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="10,8" CornerRadius="{StaticResource ARadiusMd}" Click="WorldTrigger_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="{StaticResource ARadiusSm}"
                                                    BorderBrush="{ThemeResource ABorder}" BorderThickness="1"
                                                    Background="{ThemeResource ASurface}">
                                                <shared:AppIcon IconName="globe"
                                                                IconSize="13"
                                                                Foreground="{ThemeResource ATextFaint}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0,0,0">
                                                <TextBlock x:Name="WorldSummaryLabel"
                                                           Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.allWorlds')}"
                                                           FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"
                                                           Foreground="{ThemeResource ATextDim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <shared:AppIcon Grid.Column="2"
                                                            IconName="chevronDown"
                                                            IconSize="12"
                                                            Foreground="{ThemeResource ATextFaint}"
                                                            VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="WorldDropdownPanel" Visibility="Collapsed"
                                            Background="{ThemeResource ASurface}" CornerRadius="{StaticResource ARadiusXl}"
                                            BorderBrush="{ThemeResource ABorder}" BorderThickness="1">
                                        <StackPanel>
                                            <Border Padding="10,8" BorderBrush="{ThemeResource ABorder}" BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <shared:AppIcon IconName="search"
                                                                    IconSize="14"
                                                                    Foreground="{ThemeResource ATextFaint}"
                                                                    VerticalAlignment="Center"/>
                                                    <TextBox x:Name="WorldSearchBox" Grid.Column="1"
                                                             PlaceholderText="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.worldSearchPlaceholder')}"
                                                             BorderThickness="0" Background="Transparent" Padding="0"
                                                             FontSize="{StaticResource AFontSizeMd}" HorizontalAlignment="Stretch"
                                                             TextChanged="WorldSearch_TextChanged"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="WorldCheckboxList" Spacing="2" Padding="4"/>
                                            </ScrollViewer>
                                            <Border Padding="8,6" BorderBrush="{ThemeResource ABorder}" BorderThickness="0,1,0,0">
                                                <TextBlock x:Name="WorldCountLabel" FontSize="{StaticResource AFontSizeXs}" Foreground="{ThemeResource ATextFaint}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- お気に入り -->
                    <Border Style="{StaticResource FilterPanelCardStyle}" Tag="FilterPanelCard">
                        <Border Style="{StaticResource FilterPanelCardSectionStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.favoriteHeading')}"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <Button x:Name="FavoriteToggleBtn"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="14,11" CornerRadius="14"
                                        Background="{ThemeResource ASurfaceSoft}"
                                        BorderThickness="0"
                                        Click="FavoriteToggle_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <shared:AppIcon x:Name="FavoriteStarIcon"
                                            IconName="star"
                                            IconSize="18"
                                            Foreground="{ThemeResource ATextFaint}"
                                            Width="22" Height="22"/>
                                        <TextBlock x:Name="FavoriteLabel"
                                                   Text="{x:Bind messages:MessageCatalog.getMsg('GalleryFilterPanel.favoritesOnly')}"
                                                   FontSize="{StaticResource AFontSizeMd}" FontWeight="ExtraBold"
                                                   Foreground="{ThemeResource ATextDim}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Border>

                    <Button x:Name="FolderAllBtn" Visibility="Collapsed" Click="FolderAll_Click"/>
                    <Button x:Name="FolderPrimaryBtn" Visibility="Collapsed" Click="FolderPrimary_Click"/>
                    <Button x:Name="FolderSecondaryBtn" Visibility="Collapsed" Click="FolderSecondary_Click"/>
                    <Button x:Name="GroupNoneBtn" Visibility="Collapsed" Click="GroupNone_Click"/>
                    <Button x:Name="GroupWorldBtn" Visibility="Collapsed" Click="GroupWorld_Click"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="FilterPanelFooter"
                    Grid.Row="2" Padding="14,10"
                    Background="{ThemeResource AFilterPanelBackground}"
                    BorderBrush="{ThemeResource AFilterPanelBorder}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="FilteredCountLabel"
                           FontSize="{StaticResource AFontSizeSm}"
                           Foreground="{ThemeResource ATextFaint}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
