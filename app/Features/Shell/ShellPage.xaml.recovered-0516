<Page
    x:Class="Alpheratz.Features.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellControls="using:Alpheratz.Features.Shell.Controls"
    xmlns:galleryControls="using:Alpheratz.Features.Gallery.Controls"
    Background="{ThemeResource ABg}"
    Loaded="ShellPage_Loaded"
    Unloaded="ShellPage_Unloaded"
    KeyDown="ShellPage_KeyDown">

    <Grid Background="{ThemeResource ABg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shellControls:ShellHeaderBar x:Name="HeaderBar" Grid.Row="0"
                                       Tapped="ModalDismissArea_Tapped"/>

        <!--
            Row 1 は「左レーン (検索条件) + ShellStage」の 2 カラム構成。
            検索条件は LeftRail (固定 320px) に常駐させる方針 (Step 11)。
            旧実装は HeaderBar の「検索条件」ピル → Overlay 表示だったが、
            (1) ピルがテーマ切替で見た目が壊れるバグの調査が長引いたこと、
            (2) フィルタは利用頻度が高く常時アクセスしたい操作であること、
            から左レーンに移植して常時表示に変える。
        -->
        <!--
            左レーンは展開/収納式。RailColumn.Width を切り替えることで開閉する。
            FilterPanel と Toggle ボタンを Grid で並べ、収納時は RailColumn を 28px に
            縮めて Toggle ボタンだけ見える状態にする。
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource ASurfaceSide}"
                    BorderBrush="{ThemeResource ABorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>

                    <galleryControls:GalleryFilterPanel x:Name="FilterPanel" Grid.Column="0"/>

                    <!--
                        レーン右端の細いトグルボタン。クリックでレーン全体を展開/収納する。
                        展開時: "<" を表示 (押すと閉じる)
                        収納時: ">" を表示 (押すと開く)
                    -->
                    <Button x:Name="FilterRailToggle" Grid.Column="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{ThemeResource ABorder}"
                            BorderThickness="1,0,0,0"
                            CornerRadius="0"
                            Padding="0"
                            ToolTipService.ToolTip="検索条件レーンを開閉"
                            Click="FilterRailToggle_Click">
                        <TextBlock x:Name="FilterRailToggleIcon" Text="&#x276E;"
                                   FontSize="{StaticResource AFontSizeMd}"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource ATextDim}"/>
                    </Button>
                </Grid>
            </Border>

            <shellControls:ShellStage x:Name="Stage" Grid.Column="1"/>
        </Grid>
    </Grid>
</Page>
