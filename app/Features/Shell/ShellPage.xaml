<Page
    x:Class="Alpheratz.Features.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellControls="using:Alpheratz.Features.Shell.Controls"
    xmlns:galleryControls="using:Alpheratz.Features.Gallery.Controls"
    Background="{ThemeResource ABg}"
    Loaded="ShellPage_Loaded"
    Unloaded="ShellPage_Unloaded"
    KeyDown="ShellPage_KeyDown">

    <Grid Background="{ThemeResource ABg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shellControls:ShellHeaderBar x:Name="HeaderBar" Grid.Row="0"
                                       Tapped="ModalDismissArea_Tapped"/>

        <shellControls:ShellStage x:Name="Stage" Grid.Row="1"/>

        <!--
            検索条件 overlay。ヘッダーの「検索条件」ピルでトグルする。
            重要: 旧実装は FilterPanel を GalleryPage 内に置き、開く時に
            GetFilterPanel() で親付け替えしていたが、これが ActualTheme の
            継承チェーンを切り、テーマ切替が反映されない原因だった。
            ここでは FilterPanel を最初から FilterPanelContainer 配下に固定配置し、
            開閉は FilterOverlay.Visibility のみで行う。親は一切変わらない。
        -->
        <Grid x:Name="FilterOverlay" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="FilterBackdrop"
                    Background="{ThemeResource AOverlay}"
                    Tapped="FilterBackdrop_Tapped"/>
            <Border x:Name="FilterPanelContainer" HorizontalAlignment="Left"
                    MaxWidth="540" MinWidth="320"
                    Background="{ThemeResource ASurface}">
                <galleryControls:GalleryFilterPanel x:Name="FilterPanel"/>
            </Border>
        </Grid>
    </Grid>
</Page>
