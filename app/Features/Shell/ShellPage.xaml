<Page
    x:Class="Alpheratz.Features.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellControls="using:Alpheratz.Features.Shell.Controls"
    xmlns:galleryControls="using:Alpheratz.Features.Gallery.Controls"
    Background="{ThemeResource ABg}"
    Loaded="ShellPage_Loaded"
    Unloaded="ShellPage_Unloaded"
    PreviewKeyDown="ShellPage_PreviewKeyDown"
    KeyDown="ShellPage_KeyDown">

    <Grid Background="{ThemeResource ABg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shellControls:ShellHeaderBar x:Name="HeaderBar" Grid.Row="0"
                                       Tapped="ModalDismissArea_Tapped"/>

        <shellControls:ShellStage x:Name="Stage" Grid.Row="1"/>

        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="2" Canvas.ZIndex="20" Visibility="Collapsed">
            <Border Background="{ThemeResource AOverlay}" Tapped="ConfirmBackdrop_Tapped"/>
            <Border MaxWidth="460"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource ARadiusModal}"
                    Background="{ThemeResource ASurface}"
                    BorderBrush="{ThemeResource ABorder}"
                    BorderThickness="1"
                    Tapped="ConfirmContent_Tapped">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ConfirmTitle"
                                   Style="{StaticResource HeadingTextStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ConfirmMessage"
                                   Style="{StaticResource HintTextStyle}"
                                   Foreground="{ThemeResource ATextDim}"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right">
                        <Button x:Name="ConfirmNoButton"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ConfirmNo_Click"/>
                        <Button x:Name="ConfirmYesButton"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmYes_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            検索条件パネルは初期化時から FilterPanelContainer 配下に固定配置する。
            表示時に親要素を付け替えると ActualTheme の継承が切れ、
            テーマ切替が反映されないため、開閉は Visibility の変更だけで行う。
        -->
        <Grid x:Name="FilterOverlay" Grid.Row="1" Canvas.ZIndex="10" Visibility="Collapsed">
            <Border x:Name="FilterBackdrop"
                    Background="{ThemeResource AOverlay}"
                    Tapped="FilterBackdrop_Tapped"/>
            <Border x:Name="FilterPanelContainer" HorizontalAlignment="Left"
                    Width="612" MinWidth="612" MaxWidth="612"
                    Background="{ThemeResource ASurface}">
                <galleryControls:GalleryFilterPanel x:Name="FilterPanel"/>
            </Border>
        </Grid>
    </Grid>
</Page>
