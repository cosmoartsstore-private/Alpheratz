<UserControl
    x:Class="Alpheratz.Features.Shell.Controls.ShellHeaderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:shared="using:Alpheratz.Shared.Controls">

    <Border
        Padding="{StaticResource AHeaderPadding}"
        Background="{ThemeResource ASurface}"
        BorderBrush="{ThemeResource ABorder}"
        BorderThickness="0,0,0,1">
        <!--
            "検索条件" ボタンは ShellPage 側の検索条件オーバーレイを開閉する。
            検索条件パネル自体はオーバーレイ内に固定配置し、親要素を付け替えない。
        -->
        <Grid x:Name="ContentRoot" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左側: 検索条件ボタン -->
            <Button x:Name="FilterPillBtn" Grid.Column="0"
                    Style="{StaticResource HeaderPillButtonStyle}"
                    Click="FilterButton_Click"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.filterButtonAutomation')}"
                    AutomationProperties.HelpText="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.filterButtonHelp')}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <shared:AppIcon IconName="search" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
                    <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.filterButton')}" FontSize="{StaticResource AFontSizeSm}" FontWeight="ExtraBold"/>
                    <ProgressRing x:Name="FilterBusyRing" Width="14" Height="14" IsActive="False"
                                  Visibility="Collapsed" Foreground="{ThemeResource APrimary}"/>
                    <Border MinWidth="18" Height="18" CornerRadius="{StaticResource ARadiusMd}" Background="{ThemeResource APrimary}">
                        <TextBlock
                            Text="{Binding galleryViewModel.filtersState.ActiveFilterCount}"
                            Foreground="White"
                            FontSize="{StaticResource AFontSizeXs}"
                            FontWeight="ExtraBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Button>

            <!-- 中央: 検索ボックス -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="640">
                <Border x:Name="SearchBoxBorder"
                        HorizontalAlignment="Stretch"
                        MinHeight="34"
                        CornerRadius="{StaticResource ARadiusMd}"
                        BorderBrush="{ThemeResource ABorder}"
                        BorderThickness="1"
                        Background="{ThemeResource ASurfaceSoft}"
                        Padding="13,0">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <shared:AppIcon IconName="search" IconSize="16" Foreground="{ThemeResource ATextFaint}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 Text="{Binding galleryViewModel.filtersState.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.searchPlaceholder')}"
                                 FontSize="{StaticResource AFontSizeMd}"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.searchAutomation')}"
                                 GotFocus="SearchTextBox_GotFocus"
                                 LostFocus="SearchTextBox_LostFocus"
                                 TextChanged="SearchTextBox_TextChanged"
                                 KeyDown="SearchTextBox_KeyDown"/>
                    </Grid>
                </Border>
                <primitives:Popup x:Name="SearchSuggestionPopup"
                                  IsLightDismissEnabled="True"
                                  Closed="SearchSuggestionPopup_Closed">
                    <Border x:Name="SearchSuggestionSurface"
                            MaxHeight="260"
                            Padding="4"
                            CornerRadius="{StaticResource ARadius}"
                            Background="{ThemeResource ASurface}"
                            BorderBrush="{ThemeResource ABorder}"
                            BorderThickness="1">
                        <ListView x:Name="SearchSuggestionListView"
                                  ItemsSource="{x:Bind WorldNameSuggestions, Mode=OneWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  IsItemClickEnabled="True"
                                  SelectionMode="Single"
                                  ItemClick="SearchSuggestionListView_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{StaticResource AFontSizeSm}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CountText}"
                                                   FontSize="{StaticResource AFontSizeXs}"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource ATextDisabled}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </primitives:Popup>
            </Grid>

            <!-- ギャラリーモード切替。状態を表す文言とスイッチを常時表示する。 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.galleryModeLabel')}"
                           FontSize="{StaticResource AFontSizeSm}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource ATextDim}"
                           VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="GalleryModeToggle"
                              MinWidth="0"
                              Width="48"
                              OnContent=""
                              OffContent=""
                              AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.galleryModeLabel')}"
                              ToolTipService.ToolTip="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.viewModeTooltip')}"
                              Toggled="GalleryModeToggle_Toggled"/>
            </StackPanel>

            <!-- ワールド単位のグループ化。ギャラリーモード中は利用できない。 -->
            <StackPanel x:Name="GroupPhotosControl"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.groupPhotosLabel')}"
                           FontSize="{StaticResource AFontSizeSm}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource ATextDim}"
                           VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="GroupPhotosToggle"
                              MinWidth="0"
                              Width="48"
                              OnContent=""
                              OffContent=""
                              AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.groupPhotosLabel')}"
                              ToolTipService.ToolTip="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.groupingTooltip')}"
                              Toggled="GroupPhotosToggle_Toggled"/>
            </StackPanel>

            <!-- 複数選択モード切替 -->
            <Button x:Name="MultiSelectBtn" Grid.Column="4"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.multiSelectAutomation')}"
                    ToolTipService.ToolTip="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.multiSelectTooltip')}"
                    Click="MultiSelectBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon x:Name="MultiSelectIcon" IconName="selectMultiple" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <!-- 右端: 設定ボタン -->
            <Button x:Name="SettingsGearBtn" Grid.Column="5"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.settings')}"
                    AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ShellHeaderBar.settings')}"
                    Click="SettingsGearBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon IconName="settings" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
