<UserControl
    x:Class="Alpheratz.Features.Shell.Controls.ShellHeaderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">

    <Border
        Padding="{StaticResource AHeaderPadding}"
        Background="{ThemeResource ASurface}"
        BorderBrush="{ThemeResource ABorder}"
        BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: filter pill -->
            <Button x:Name="FilterPillBtn" Grid.Column="0"
                    Style="{StaticResource HeaderPillButtonStyle}"
                    Click="FilterButton_Click"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="検索条件を開く"
                    AutomationProperties.HelpText="ワールド・タグ・撮影日・お気に入りで絞り込むパネルを表示します">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <shared:AppIcon IconName="search" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
                    <TextBlock Text="検索条件" FontSize="{StaticResource AFontSizeSm}" FontWeight="ExtraBold"/>
                    <Border MinWidth="18" Height="18" CornerRadius="{StaticResource ARadiusMd}" Background="{ThemeResource APrimary}">
                        <TextBlock
                            Text="{Binding galleryViewModel.filtersState.ActiveFilterCount}"
                            Foreground="White"
                            FontSize="10"
                            FontWeight="ExtraBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Button>

            <!-- Center: search box -->
            <Border x:Name="SearchBoxBorder" Grid.Column="1"
                    MaxWidth="472"
                    HorizontalAlignment="Stretch"
                    MinHeight="34"
                    CornerRadius="{StaticResource ARadiusMd}"
                    BorderBrush="{ThemeResource ABorder}"
                    BorderThickness="1"
                    Background="{ThemeResource ASurfaceSoft}"
                    Padding="13,0">
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <shared:AppIcon IconName="search" IconSize="16"
                                   Foreground="{ThemeResource ATextFaint}"
                                   VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             Text="{Binding galleryViewModel.filtersState.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="ワールド名で検索..."
                             FontSize="{StaticResource AFontSizeMd}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="ワールド名検索"
                             GotFocus="SearchTextBox_GotFocus"
                             LostFocus="SearchTextBox_LostFocus"/>
                </Grid>
            </Border>

            <!-- Right: settings gear -->
            <Button x:Name="SettingsGearBtn" Grid.Column="2"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="設定"
                    AutomationProperties.Name="設定"
                    AutomationProperties.HelpText="アプリの設定画面を開きます"
                    Click="SettingsGearBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon IconName="settings" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
