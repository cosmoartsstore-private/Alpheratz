<UserControl
    x:Class="Alpheratz.Features.Shell.Controls.ShellHeaderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">

    <Border
        Padding="{StaticResource AHeaderPadding}"
        Background="{ThemeResource ASurface}"
        BorderBrush="{ThemeResource ABorder}"
        BorderThickness="0,0,0,1">
        <!--
            "検索条件" ボタンは ShellPage 側の検索条件オーバーレイを開閉する。
            検索条件パネル自体はオーバーレイ内に固定配置し、親要素を付け替えない。
        -->
        <Grid x:Name="ContentRoot" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左側: 検索条件ボタン -->
            <Button x:Name="FilterPillBtn" Grid.Column="0"
                    Style="{StaticResource HeaderPillButtonStyle}"
                    Click="FilterButton_Click"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="検索条件パネル開閉"
                    AutomationProperties.HelpText="検索条件パネルを開閉します">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <shared:AppIcon IconName="search" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
                    <TextBlock Text="検索条件" FontSize="{StaticResource AFontSizeSm}" FontWeight="ExtraBold"/>
                    <Border MinWidth="18" Height="18" CornerRadius="{StaticResource ARadiusMd}" Background="{ThemeResource APrimary}">
                        <TextBlock
                            Text="{Binding galleryViewModel.filtersState.ActiveFilterCount}"
                            Foreground="White"
                            FontSize="{StaticResource AFontSizeXs}"
                            FontWeight="ExtraBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Button>

            <!-- 中央: 検索ボックス -->
            <Border x:Name="SearchBoxBorder" Grid.Column="1"
                    MaxWidth="472"
                    HorizontalAlignment="Stretch"
                    MinHeight="34"
                    CornerRadius="{StaticResource ARadiusMd}"
                    BorderBrush="{ThemeResource ABorder}"
                    BorderThickness="1"
                    Background="{ThemeResource ASurfaceSoft}"
                    Padding="13,0">
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <shared:AppIcon IconName="search" IconSize="16"
                                   Foreground="{ThemeResource ATextFaint}"
                                   VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             Text="{Binding galleryViewModel.filtersState.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="ワールド名で検索..."
                             FontSize="{StaticResource AFontSizeMd}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="ワールド名検索"
                             GotFocus="SearchTextBox_GotFocus"
                             LostFocus="SearchTextBox_LostFocus"
                             KeyDown="SearchTextBox_KeyDown"/>
                </Grid>
            </Border>

            <!--
                PDQ 進捗表示。
                ハッシュ計算中だけ表示され、完了数 / 全体数をコンパクトに示す。
                visibility は SetPdqProgress 経由でコード側からセットする。
            -->
            <Border x:Name="PdqProgressChip" Grid.Column="2"
                    Visibility="Collapsed"
                    MinHeight="24"
                    Padding="10,2"
                    CornerRadius="{StaticResource ARadiusPill}"
                    BorderBrush="{ThemeResource ABorderStrong}"
                    BorderThickness="1"
                    Background="{ThemeResource APrimarySoft}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="類似画像 (PDQ) ハッシュの計算進捗"
                    AutomationProperties.Name="PDQ 進捗">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="12" Height="12"
                                  Foreground="{ThemeResource APrimary}"
                                  VerticalAlignment="Center"/>
                    <TextBlock x:Name="PdqProgressText"
                               FontSize="{StaticResource AFontSizeXs}"
                               FontWeight="Bold"
                               Foreground="{ThemeResource APrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!--
                右側: ギャラリー表示操作と設定。
                3 つの切替ボタン (ビューモード / グループ化 / 複数選択) を、
                設定ボタンの直前に並べる。各ボタンは 2 状態切替で、アクティブ時に
                背景・枠線・前景色が APrimarySoft / ABorderStrong / APrimary に切り替わる
                (UpdateActiveStyle ヘルパで code-behind から付与)。
            -->

            <!-- 表示モード切替 (標準グリッド / マソンリー) -->
            <Button x:Name="ViewModeBtn" Grid.Column="3"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    AutomationProperties.Name="表示モード切替"
                    ToolTipService.ToolTip="表示モード切替 (標準グリッド / マソンリー)"
                    Click="ViewModeBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon x:Name="ViewModeIcon" IconName="grid" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <!-- グループ化切替 (なし / ワールド)。Masonry 表示中は無効化される。 -->
            <Button x:Name="GroupingBtn" Grid.Column="4"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    AutomationProperties.Name="グループ化切替"
                    ToolTipService.ToolTip="ワールド単位でグループ化"
                    Click="GroupingBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon x:Name="GroupingIcon" IconName="group" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <!-- 複数選択モード切替 -->
            <Button x:Name="MultiSelectBtn" Grid.Column="5"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    AutomationProperties.Name="複数選択モード切替"
                    ToolTipService.ToolTip="複数選択モードを切り替える"
                    Click="MultiSelectBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon x:Name="MultiSelectIcon" IconName="selectMultiple" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <!-- 右端: 設定ボタン -->
            <Button x:Name="SettingsGearBtn" Grid.Column="6"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="設定"
                    AutomationProperties.Name="設定"
                    AutomationProperties.HelpText="アプリの設定画面を開きます"
                    Click="SettingsGearBtn_Click"
                    VerticalAlignment="Center">
                <shared:AppIcon IconName="settings" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
