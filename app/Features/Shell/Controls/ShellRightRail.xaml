<UserControl
    x:Class="Alpheratz.Features.Shell.Controls.ShellRightRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Border Width="56"
            Background="{ThemeResource ASurfaceSide}"
            BorderBrush="{ThemeResource ABorder}"
            BorderThickness="1,0,0,0">
        <StackPanel Padding="8,12" Spacing="6" HorizontalAlignment="Center">
            <Button x:Name="MultiSelectBtn"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    Click="MultiSelectButton_Click"
                    ToolTipService.ToolTip="複数選択">
                <shared:AppIcon IconName="selectMultiple" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <Button x:Name="ViewModeBtn"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    Click="ViewModeButton_Click"
                    ToolTipService.ToolTip="表示モード切替">
                <shared:AppIcon x:Name="ViewModeIcon" IconName="grid" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <Button Style="{StaticResource HeaderIconButtonStyle}"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="再読み込み">
                <shared:AppIcon IconName="refresh" IconSize="16" Foreground="{ThemeResource ATextDim}"/>
            </Button>

            <Rectangle Height="1" Margin="6,4" Fill="{ThemeResource ABorder}"/>

            <!-- PDQ progress chip -->
            <Border MinHeight="22"
                    Padding="6,2"
                    CornerRadius="11"
                    BorderBrush="{ThemeResource ABorder}"
                    BorderThickness="1"
                    Background="{ThemeResource APrimarySoft}"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="類似ハッシュ計算進捗">
                <TextBlock Text="{Binding PdqProgress.current}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{ThemeResource APrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
