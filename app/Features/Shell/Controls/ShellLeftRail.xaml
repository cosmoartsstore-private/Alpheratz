<UserControl
    x:Class="Alpheratz.Features.Shell.Controls.ShellLeftRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Border Width="196"
            Background="{ThemeResource ASurfaceSide}"
            BorderBrush="{ThemeResource ABorder}"
            BorderThickness="0,0,1,0"
            Padding="8,14">

        <!-- Gallery mode (default) -->
        <StackPanel x:Name="GalleryModePanel" Spacing="14">

            <!-- ギャラリーに戻る (non-gallery screens only) -->
            <Button x:Name="BackToGalleryBtn"
                    Style="{StaticResource RailButtonStyle}"
                    Visibility="Collapsed"
                    Click="BackToGalleryBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="20" Height="20">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"
                                  Foreground="{ThemeResource ATextDim}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ギャラリーに戻る" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <!-- 編集 -->
            <StackPanel Spacing="4">
                <TextBlock Text="編集" FontSize="{StaticResource AFontSizeXs}" FontWeight="ExtraBold"
                           Foreground="{ThemeResource ATextFaint}" Margin="12,0,0,6"/>
                <Button x:Name="MultiSelectBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="MultiSelectBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="selectMultiple" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="複数選択" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TagMasterBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="TagMasterBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="tag" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="タグマスタ編集" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TemplateBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="TemplateBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="template" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="テンプレート編集" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- グループ化 -->
            <StackPanel x:Name="GroupingSection" Spacing="4">
                <TextBlock Text="グループ化" FontSize="{StaticResource AFontSizeXs}" FontWeight="ExtraBold"
                           Foreground="{ThemeResource ATextFaint}" Margin="12,0,0,6"/>
                <Button x:Name="GroupNoneBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="GroupNoneBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="group" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="なし" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="GroupWorldBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="GroupWorldBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="globe" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ワールド" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 表示形式 (gallery screen only) -->
            <StackPanel x:Name="ViewModeSection" Spacing="4">
                <TextBlock Text="表示形式" FontSize="{StaticResource AFontSizeXs}" FontWeight="ExtraBold"
                           Foreground="{ThemeResource ATextFaint}" Margin="12,0,0,6"/>
                <Button x:Name="ViewGridBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="ViewGridBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="grid" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="グリッド" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ViewGalleryBtn"
                        Style="{StaticResource RailButtonStyle}"
                        Click="ViewGalleryBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="20" Height="20">
                            <shared:AppIcon IconName="gallery" IconSize="16"
                                            Foreground="{ThemeResource ATextDim}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ギャラリー" FontSize="{StaticResource AFontSizeMd}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
