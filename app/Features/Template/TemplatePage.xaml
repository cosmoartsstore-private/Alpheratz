<Page
    x:Class="Alpheratz.Features.Template.TemplatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="{ThemeResource ASurface}"
    Unloaded="Page_Unloaded">

    <Grid Margin="28,58,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="0.9*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Editor panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="20,22" Spacing="16">
                <TextBlock Text="投稿テンプレート" Style="{StaticResource HeadingTextStyle}"/>

                <StackPanel Spacing="12">
                    <TextBlock x:Name="EditorModeLabel"
                               Text="新規テンプレート"
                               Style="{StaticResource SubHeadingTextStyle}"/>
                    <TextBox Text="{Binding TweetTemplateDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="320"
                             FontFamily="{StaticResource AFontMono}"
                             FontSize="{StaticResource AFontSizeMd}"
                             PlaceholderText="例:&#x0a;World: {}{world-name}&#x0a;Author:&#x0a;&#x0a;#VRChat_world紹介"/>
                </StackPanel>

                <TextBlock Style="{StaticResource HintTextStyle}">
                    <Run Text="使える置換: "/>
                    <Run Text="{}{world-name}" Foreground="{ThemeResource APrimary}" FontFamily="{StaticResource AFontMono}"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CancelEditButton"
                            Content="キャンセル"
                            Style="{StaticResource GhostButtonStyle}"
                            Visibility="Collapsed"
                            Click="CancelEdit_Click"/>
                    <Button x:Name="SaveButton"
                            Content="登録"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveTemplate_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Center: vertical separator -->
        <Border Grid.Column="1" Width="1" Background="{ThemeResource ABorderMid}"/>

        <!-- Right: Template list panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="20,22" Spacing="16">
                <TextBlock Text="テンプレート一覧" Style="{StaticResource HeadingTextStyle}"/>
                <TextBlock Text="登録済みテンプレート" Style="{StaticResource SubHeadingTextStyle}"/>

                <ItemsControl x:Name="TemplateList" ItemsSource="{Binding tweetTemplates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14"
                                    CornerRadius="{StaticResource ARadiusLg}"
                                    BorderBrush="{ThemeResource ABorder}"
                                    BorderThickness="1"
                                    Background="{ThemeResource ASurfaceSoft}"
                                    Loaded="TemplateCard_Loaded"
                                    PointerPressed="TemplateCard_PointerPressed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="TemplateLabel"
                                                   Text="テンプレート"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="8"
                                                   FontFamily="{StaticResource AFontMono}"
                                                   FontSize="{StaticResource AFontSizeSm}"
                                                   LineHeight="20"
                                                   Foreground="{ThemeResource AText}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="6"
                                                VerticalAlignment="Top">
                                        <Button Content="編集"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="10,4"
                                                MinWidth="0" MinHeight="0"
                                                FontSize="{StaticResource AFontSizeSm}"
                                                Click="EditTemplate_Click"/>
                                        <Button Content="削除"
                                                Padding="10,4"
                                                MinWidth="0" MinHeight="0"
                                                CornerRadius="{StaticResource ARadiusMd}"
                                                Background="{ThemeResource ADangerSoft}"
                                                BorderBrush="{ThemeResource ADangerBorder}"
                                                BorderThickness="1"
                                                Foreground="{ThemeResource ADanger}"
                                                FontSize="{StaticResource AFontSizeSm}"
                                                FontWeight="SemiBold"
                                                Click="DeleteTemplate_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
