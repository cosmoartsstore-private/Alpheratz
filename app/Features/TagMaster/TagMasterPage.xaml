<Page
    x:Class="Alpheratz.Features.TagMaster.TagMasterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    Background="{ThemeResource ASurface}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="48,58,48,32" Spacing="20">

            <TextBlock Text="タグマスタ編集" Style="{StaticResource HeadingTextStyle}"/>

            <Border Style="{StaticResource SectionCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="タグを追加する" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TagInputBox"
                                 Text="{Binding TagDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="タグを追加"
                                 KeyDown="TagInput_KeyDown"/>
                        <Button Grid.Column="1"
                                Content="追加"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddTag_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="追加済みタグ" Style="{StaticResource SectionTitleStyle}"/>

                    <!-- Empty state -->
                    <Border x:Name="TagEmptyState"
                            Padding="14,12"
                            CornerRadius="{StaticResource ARadiusLg}"
                            BorderBrush="{ThemeResource ABorderMid}"
                            BorderThickness="1"
                            Background="{ThemeResource ASurfaceSoft}"
                            Visibility="Collapsed">
                        <TextBlock Text="タグマスタはまだありません。"
                                   Foreground="{ThemeResource ATextFaint}"
                                   FontSize="13"/>
                    </Border>

                    <!-- Tag flow list -->
                    <ItemsControl x:Name="TagRepeater" ItemsSource="{Binding masterTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <shared:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                        CornerRadius="{StaticResource ARadiusLg}"
                                        BorderBrush="{ThemeResource ABorderMid}"
                                        BorderThickness="1"
                                        Background="{ThemeResource ASurfaceSoft}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AText}"/>
                                        <Button Content="削除"
                                                Padding="10,4"
                                                MinWidth="0" MinHeight="0"
                                                CornerRadius="{StaticResource ARadiusMd}"
                                                Background="{ThemeResource ADangerSoft}"
                                                BorderBrush="{ThemeResource ADangerBorder}"
                                                BorderThickness="1"
                                                Foreground="{ThemeResource ADanger}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="DeleteTag_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
