<UserControl
    x:Class="Alpheratz.Shared.Controls.ScanningOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Grid Background="{ThemeResource AOverlay}">
        <Border Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource ARadiusXl}"
                Padding="28"
                Background="{ThemeResource ASurface}"
                BorderBrush="{ThemeResource ABorder}"
                BorderThickness="1">
            <StackPanel Spacing="14">
                <ProgressRing Width="44" Height="44" IsActive="True" HorizontalAlignment="Center"
                              Foreground="{ThemeResource APrimary}"/>
                <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('ScanningOverlay.heading')}"
                           FontSize="{StaticResource AFontSize2Xl}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ScanProgress.current_world}"
                           Style="{StaticResource HintTextStyle}"
                           AutomationProperties.LiveSetting="Polite"
                           TextAlignment="Center"/>
                <shared:WaveProgressBar Minimum="0"
                                        Maximum="{Binding ScanProgress.total}"
                                        Value="{Binding ScanProgress.processed}"
                                        AutomationProperties.Name="{x:Bind messages:MessageCatalog.getMsg('ScanningOverlay.progress')}"
                                        Height="8"/>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ScanProgress.processed}" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource ATextDim}"/>
                    <TextBlock Text="/" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource ATextDim}"/>
                    <TextBlock Text="{Binding ScanProgress.total}" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource ATextDim}"/>
                </StackPanel>
                <Button Content="{x:Bind messages:MessageCatalog.getMsg('ScanningOverlay.cancel')}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Center" Click="CancelScan_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
