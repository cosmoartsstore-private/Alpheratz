<UserControl
    x:Class="Alpheratz.Shared.Controls.WaveProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="3"
    IsHitTestVisible="False"
    Loaded="WaveProgressBar_Loaded"
    Unloaded="WaveProgressBar_Unloaded"
    SizeChanged="WaveProgressBar_SizeChanged">
    <Grid x:Name="TrackRoot" MinHeight="3" VerticalAlignment="Stretch">
        <Border x:Name="TrackBorder"
                Background="{ThemeResource AProgressBarTrack}"
                CornerRadius="1"/>
        <Border x:Name="FillBorder"
                Width="0"
                HorizontalAlignment="Left"
                Background="{ThemeResource APrimary}"
                CornerRadius="1"/>
        <Border x:Name="IndeterminateSegment"
                Width="0"
                HorizontalAlignment="Left"
                Opacity="0"
                Background="{ThemeResource APrimary}"
                CornerRadius="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="IndeterminateTransform"/>
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
