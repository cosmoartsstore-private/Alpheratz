<UserControl
    x:Class="Alpheratz.Shared.Controls.WaveProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="6"
    IsHitTestVisible="False"
    Loaded="WaveProgressBar_Loaded"
    Unloaded="WaveProgressBar_Unloaded"
    SizeChanged="WaveProgressBar_SizeChanged">
    <Grid x:Name="TrackRoot" MinHeight="6" VerticalAlignment="Stretch">
        <Border x:Name="TrackBorder"
                Background="{ThemeResource AProgressBarTrack}"
                CornerRadius="{StaticResource ARadiusPill}"/>
        <Border x:Name="FillBorder"
                Width="0"
                HorizontalAlignment="Left"
                Background="{ThemeResource APrimary}"
                CornerRadius="{StaticResource ARadiusPill}">
            <Grid>
                <Border x:Name="HighlightBand"
                        Width="120"
                        HorizontalAlignment="Left"
                        Opacity="0.70">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00FFFFFF" Offset="0.00"/>
                            <GradientStop Color="#30FFFFFF" Offset="0.20"/>
                            <GradientStop Color="#66FFFFFF" Offset="0.40"/>
                            <GradientStop Color="#88FFFFFF" Offset="0.50"/>
                            <GradientStop Color="#66FFFFFF" Offset="0.60"/>
                            <GradientStop Color="#30FFFFFF" Offset="0.80"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.00"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="HighlightTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
