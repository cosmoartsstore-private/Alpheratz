<UserControl
    x:Class="Alpheratz.Shared.Controls.PhotoGridPager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Border BorderBrush="{ThemeResource ABorder}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource ASurface}"
            Padding="14,10">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Prev -->
            <Button Grid.Column="0"
                    MinWidth="92"
                    Style="{StaticResource HeaderPillButtonStyle}"
                    Click="PrevPage_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <shared:AppIcon IconName="back" IconSize="12" Foreground="{ThemeResource AText}"/>
                    <TextBlock Text="前へ" FontSize="12" FontWeight="ExtraBold"/>
                </StackPanel>
            </Button>

            <!-- Centered counter + ring -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="14" Height="14" IsActive="{Binding IsLoadingMore}"/>
                <TextBlock Text="{Binding totalCount}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource ATextDim}"/>
                <TextBlock Text="件"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource ATextFaint}"/>
            </StackPanel>

            <!-- Next -->
            <Button Grid.Column="2"
                    MinWidth="92"
                    Style="{StaticResource HeaderPillButtonStyle}"
                    Click="NextPage_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="次へ" FontSize="12" FontWeight="ExtraBold"/>
                    <shared:AppIcon IconName="next" IconSize="12" Foreground="{ThemeResource AText}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
