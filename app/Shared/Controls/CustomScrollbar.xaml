<UserControl
    x:Class="Alpheratz.Shared.Controls.CustomScrollbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="12">
    <Grid x:Name="Track"
          Background="Transparent"
          PointerEntered="Track_PointerEntered"
          PointerExited="Track_PointerExited"
          PointerPressed="Track_PointerPressed"
          PointerMoved="Track_PointerMoved"
          PointerReleased="Track_PointerReleased"
          PointerCanceled="Track_PointerCanceled"
          PointerCaptureLost="Track_PointerCaptureLost">
        <!-- Track rail (subtle rounded background behind the thumb) -->
        <Border x:Name="TrackRail"
                Margin="4,0"
                CornerRadius="{StaticResource ARadiusPill}"
                Background="{ThemeResource AScrollbarTrack}"
                Opacity="0"/>
        <!-- Thumb (rounded, animated to thicker on hover) -->
        <Border x:Name="Thumb"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="{StaticResource ARadiusPill}"
                Background="{ThemeResource AScrollbarThumb}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ThumbTransform"/>
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
