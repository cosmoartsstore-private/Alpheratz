<UserControl
    x:Class="Alpheratz.Shared.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Grid Padding="32">
        <!-- Background watermark logo (stub: current opaque PNG, swap when alpha asset is ready). -->
        <Image Source="ms-appx:///Assets/Logo.png"
               Stretch="Uniform"
               MaxWidth="520"
               Opacity="0.06"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="380">
            <Border Width="88" Height="88" CornerRadius="28"
                    Background="{ThemeResource ASurfaceSoft}"
                    HorizontalAlignment="Center">
                <shared:AppIcon IconName="photo" IconSize="36"
                               Foreground="{ThemeResource ATextFaint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="写真が見つかりません" FontSize="{StaticResource AFontSizeXl}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="フォルダ設定または検索条件を確認してください。"
                       Style="{StaticResource HintTextStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
