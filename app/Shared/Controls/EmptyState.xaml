<UserControl
    x:Class="Alpheratz.Shared.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Alpheratz.Messages"
    xmlns:shared="using:Alpheratz.Shared.Controls">
    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="380">
            <Border Width="88" Height="88" CornerRadius="{StaticResource ARadiusModal}"
                    Background="{ThemeResource ASurfaceSoft}"
                    HorizontalAlignment="Center">
                <shared:AppIcon IconName="photo" IconSize="36"
                               Foreground="{ThemeResource ATextFaint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('EmptyState.heading')}" FontSize="{StaticResource AFontSizeXl}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="{x:Bind messages:MessageCatalog.getMsg('EmptyState.guidance')}"
                       Style="{StaticResource HintTextStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
