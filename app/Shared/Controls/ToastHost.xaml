<UserControl x:Class="Alpheratz.Shared.Controls.ToastHost" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:Alpheratz.Shared.Converters">
    <UserControl.Resources>
        <converters:ToastAccentBrushConverter x:Key="ToastAccentBrushConverter"/>
        <converters:ToastIconConverter x:Key="ToastIconConverter"/>
    </UserControl.Resources>
    <Grid IsHitTestVisible="False">
        <ItemsControl ItemsSource="{Binding toastState.toasts}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition/>
                    <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0"/>
                </TransitionCollection>
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border MinWidth="260" MaxWidth="420" Margin="0,0,0,8" CornerRadius="{StaticResource ARadius}" Background="{ThemeResource ASurface}" BorderBrush="{ThemeResource ABorder}" BorderThickness="1">
                        <!-- 本文列へ有限幅を割り当て、長い復旧案内もToast内に折り返す。 -->
                        <Grid ColumnSpacing="10" Padding="14,10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Type, Converter={StaticResource ToastIconConverter}}" Foreground="{Binding Type, Converter={StaticResource ToastAccentBrushConverter}}" FontSize="{StaticResource AFontSizeLg}" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Msg}" Foreground="{ThemeResource AText}" FontSize="{StaticResource AFontSizeMd}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
