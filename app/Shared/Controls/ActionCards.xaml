<UserControl
    x:Class="Alpheratz.Shared.Controls.ActionCards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Alpheratz.Shared.Controls"
    x:Name="Root">
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ScanCard" Grid.Column="0" Style="{StaticResource SectionCardBorderStyle}" Padding="16" Tapped="ScanCard_Tapped">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource APrimarySoft}">
                    <shared:AppIcon IconName="refresh" IconSize="22" Foreground="{ThemeResource APrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="ScanTitle" Text="再スキャン" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScanDescription" Text="写真を最新状態へ更新します" Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource SectionCardBorderStyle}" Padding="16" Tapped="SettingsCard_Tapped">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource APrimarySoft}">
                    <shared:AppIcon IconName="settings" IconSize="22" Foreground="{ThemeResource APrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="設定" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="フォルダと起動方法を変更します" Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SectionCardBorderStyle}" Padding="16" Tapped="FilterCard_Tapped">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource APrimarySoft}">
                    <shared:AppIcon IconName="search" IconSize="22" Foreground="{ThemeResource APrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="絞り込み" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="条件検索パネルを開きます" Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
