<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- アプリ内の TextBlock / TextBox に適用する既定 style。 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AFontSans}"/>
        <Setter Property="Foreground" Value="{ThemeResource AText}"/>
        <Setter Property="IsTextSelectionEnabled" Value="False"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{ThemeResource AFontSans}"/>
        <Setter Property="Foreground" Value="{ThemeResource AText}"/>
        <Setter Property="Background" Value="{ThemeResource ASurfaceSoft}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ABorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ARadiusMd}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Page heading (e.g. "設定" "テンプレート") -->
    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AFontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource AFontSize3Xl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource AText}"/>
    </Style>

    <!-- Card / panel section title (e.g. "写真フォルダ 1st") -->
    <Style x:Key="SubHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AFontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource AFontSizeMd}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource AText}"/>
    </Style>

    <!-- Filter / form section label ("ワールド名" "プリセット") -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AFontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource AFontSizeXs}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{ThemeResource ATextFaint}"/>
    </Style>

    <!-- 見出しの下に表示する補足文 -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AFontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource AFontSizeSm}"/>
        <Setter Property="Foreground" Value="{ThemeResource ATextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Numeric / metadata caption (e.g. "25枚 該当", "12 ワールド") -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AFontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource AFontSizeXs}"/>
        <Setter Property="Foreground" Value="{ThemeResource ATextFaint}"/>
    </Style>
</ResourceDictionary>
