<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 写真カードの枠 -->
    <Style x:Key="PhotoCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ABorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource ASurface}"/>
    </Style>

    <!-- Settings / Template / TagMaster 内の section panel -->
    <Style x:Key="SectionCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ARadiusLg}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ABorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource ASurfaceSoft}"/>
        <Setter Property="Padding" Value="{StaticResource ASectionPadding}"/>
    </Style>

    <!-- 左右の sidebar（検索条件と月別移動） -->
    <Style x:Key="SidebarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ASurfaceSide}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ABorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- モーダルとダイアログの内部 panel -->
    <Style x:Key="ModalPanelBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ARadiusXl}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ABorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource ASurface}"/>
        <Setter Property="Padding" Value="{StaticResource ASectionPadding}"/>
    </Style>

</ResourceDictionary>
