<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout dimensions -->
    <x:Double x:Key="AHeaderHeight">44</x:Double>
    <x:Double x:Key="AFilterSidebarWidth">560</x:Double>
    <x:Double x:Key="APhotoCardWidth">260</x:Double>
    <x:Double x:Key="APhotoCardHeight">212</x:Double>
    <x:Double x:Key="APhotoCardThumbHeight">134</x:Double>
    <x:Double x:Key="AModalMaxWidth">1180</x:Double>
    <x:Double x:Key="AModalMaxHeight">760</x:Double>

    <!-- Font sizes -->
    <x:Double x:Key="AFontSizeXs">11</x:Double>
    <x:Double x:Key="AFontSizeSm">12</x:Double>
    <x:Double x:Key="AFontSizeMd">13</x:Double>
    <x:Double x:Key="AFontSizeLg">15</x:Double>
    <x:Double x:Key="AFontSizeXl">18</x:Double>
    <x:Double x:Key="AFontSize2Xl">22</x:Double>
    <x:Double x:Key="AFontSize3Xl">28</x:Double>

    <!-- Padding -->
    <Thickness x:Key="AHeaderPadding">12,5</Thickness>
    <Thickness x:Key="ASectionPadding">18</Thickness>
    <Thickness x:Key="ACardPadding">16</Thickness>

    <!-- Corner radii -->
    <CornerRadius x:Key="ARadius">12</CornerRadius>
    <CornerRadius x:Key="ARadiusSm">8</CornerRadius>
    <CornerRadius x:Key="ARadiusMd">10</CornerRadius>
    <CornerRadius x:Key="ARadiusLg">14</CornerRadius>
    <CornerRadius x:Key="ARadiusXl">18</CornerRadius>
    <CornerRadius x:Key="ARadiusPill">999</CornerRadius>

    <!-- Font families -->
    <FontFamily x:Key="AFontSans">Noto Sans JP, Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="AFontMono">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
</ResourceDictionary>
