            <SolidColorBrush x:Key="AAccent" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="ABg" Color="#0B0D10"/>
            <SolidColorBrush x:Key="ASurface" Color="#16181C"/>
            <SolidColorBrush x:Key="ASurfaceSoft" Color="#1E2126"/>
            <SolidColorBrush x:Key="ASurfaceSofter" Color="#23262C"/>
            <SolidColorBrush x:Key="ASurfaceHover" Color="#262A30"/>
            <SolidColorBrush x:Key="ASurfaceTop" Color="#0F1115"/>
            <SolidColorBrush x:Key="ASurfaceSide" Color="#13161A"/>
            <SolidColorBrush x:Key="ASurfaceVeil" Color="#B316181C"/>
            <SolidColorBrush x:Key="ABorder" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="ABorderMid" Color="#3DFFFFFF"/>
            <SolidColorBrush x:Key="ABorderStrong" Color="#661D9BF0"/>
            <SolidColorBrush x:Key="AText" Color="#F0F2F3"/>
            <SolidColorBrush x:Key="ATextDim" Color="#A8B0B8"/>
            <SolidColorBrush x:Key="ATextFaint" Color="#7E8690"/>
            <SolidColorBrush x:Key="ATextDisabled" Color="#3A3D43"/>
            <SolidColorBrush x:Key="APrimary" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="APrimaryHover" Color="#45ADF4"/>
            <SolidColorBrush x:Key="APrimaryPressed" Color="#1577B5"/>
            <SolidColorBrush x:Key="APrimarySoft" Color="#1F2C3A"/>
            <SolidColorBrush x:Key="APrimarySoftHover" Color="#283A4E"/>
            <SolidColorBrush x:Key="AAccentSoft" Color="#1F2C3A"/>
            <SolidColorBrush x:Key="AWarn" Color="#FBBF24"/>
            <SolidColorBrush x:Key="ADanger" Color="#F87171"/>
            <SolidColorBrush x:Key="ADangerSolid" Color="#EF4444"/>
            <SolidColorBrush x:Key="ADangerSoft" Color="#1FF87171"/>
            <SolidColorBrush x:Key="ADangerBorder" Color="#47F87171"/>
            <SolidColorBrush x:Key="AFavorite" Color="#FBBF24"/>
            <SolidColorBrush x:Key="AFavoriteSoft" Color="#24FBBF24"/>
            <SolidColorBrush x:Key="AFavoriteBorder" Color="#55FBBF24"/>
            <SolidColorBrush x:Key="AOverlay" Color="#80000000"/>
            <SolidColorBrush x:Key="ADarkOverlay" Color="#B3000000"/>
            <SolidColorBrush x:Key="AScrollbarTrack" Color="#0FFFFFFF"/>
            <SolidColorBrush x:Key="AScrollbarThumb" Color="#421D9BF0"/>
            <SolidColorBrush x:Key="AScrollbarThumbHover" Color="#661D9BF0"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
