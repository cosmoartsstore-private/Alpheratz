<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        テーマ対応ブラシ。旧 alpheratz CSS 変数から移植。
        ・サーフェイスは ABg < ASurface < ASurfaceSoft < ASurfaceTop の階層を明示的に分離する。
          以前は Dark で ASurface == ASurfaceSoft で階層が消えていた。
        ・アクセントは Hover / Pressed / Soft / SoftHover で 4 段階の階層を持たせる。
        ・ATextFaint は WCAG AA を狙って Light/Dark とも引き上げる。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- ToggleSwitch overrides -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1A8CD8"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1577B5"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#1A8CD8"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1577B5"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E8EBED"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#DDE1E4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#1A000000"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#1A000000"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#536471"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#0F1419"/>

            <SolidColorBrush x:Key="AAccent" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="ABg" Color="#F2F4F6"/>
            <SolidColorBrush x:Key="ASurface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ASurfaceSoft" Color="#EEF1F4"/>
            <SolidColorBrush x:Key="ASurfaceSofter" Color="#F7F9FB"/>
            <SolidColorBrush x:Key="ASurfaceHover" Color="#E4E9EE"/>
            <SolidColorBrush x:Key="ASurfaceTop" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ASurfaceSide" Color="#FAFBFC"/>
            <SolidColorBrush x:Key="ASurfaceVeil" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="ABorder" Color="#1F000000"/>
            <SolidColorBrush x:Key="ABorderMid" Color="#33000000"/>
            <SolidColorBrush x:Key="ABorderStrong" Color="#4D1D9BF0"/>
            <SolidColorBrush x:Key="AText" Color="#0F1419"/>
            <SolidColorBrush x:Key="ATextDim" Color="#536471"/>
            <SolidColorBrush x:Key="ATextFaint" Color="#6C7A87"/>
            <SolidColorBrush x:Key="ATextDisabled" Color="#C4CFD6"/>
            <SolidColorBrush x:Key="APrimary" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="APrimaryHover" Color="#1A8CD8"/>
            <SolidColorBrush x:Key="APrimaryPressed" Color="#1577B5"/>
            <SolidColorBrush x:Key="APrimarySoft" Color="#D9ECFB"/>
            <SolidColorBrush x:Key="APrimarySoftHover" Color="#C6E1F6"/>
            <SolidColorBrush x:Key="AAccentSoft" Color="#D9ECFB"/>
            <SolidColorBrush x:Key="AWarn" Color="#D97706"/>
            <SolidColorBrush x:Key="ADanger" Color="#DC2626"/>
            <SolidColorBrush x:Key="ADangerSolid" Color="#EF4444"/>
            <SolidColorBrush x:Key="ADangerSoft" Color="#0FDC2626"/>
            <SolidColorBrush x:Key="ADangerBorder" Color="#29DC2626"/>
            <SolidColorBrush x:Key="AFavorite" Color="#D97706"/>
            <SolidColorBrush x:Key="AFavoriteSoft" Color="#1ED97706"/>
            <SolidColorBrush x:Key="AFavoriteBorder" Color="#40D97706"/>
            <SolidColorBrush x:Key="AOverlay" Color="#66000000"/>
            <SolidColorBrush x:Key="ADarkOverlay" Color="#B3000000"/>
            <SolidColorBrush x:Key="AScrollbarTrack" Color="#0F1D9BF0"/>
            <SolidColorBrush x:Key="AScrollbarThumb" Color="#331D9BF0"/>
            <SolidColorBrush x:Key="AScrollbarThumbHover" Color="#4D1D9BF0"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- ToggleSwitch overrides -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1A8CD8"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1577B5"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#1D9BF0"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#1A8CD8"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1577B5"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#2F3336"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#3A3D40"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#71767B"/>
