<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- WinUI 3 requires a Windows TFM with a concrete target platform. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>

    <RootNamespace>Alpheratz</RootNamespace>
    <UseWinUI>true</UseWinUI>

    <!-- NSIS/unpackaged distribution. Do not switch this project back to WPF/MSIX-only packaging. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnablePriGenTooling>false</EnablePriGenTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <AppxGetPackagePropertiesEnabled>false</AppxGetPackagePropertiesEnabled>
    <IncludeProjectPriFile>false</IncludeProjectPriFile>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!--
        Self-contained 配布 (Release のみ):
        Debug ビルドは dotnet build しかしないため SDK の DLL が AppLocal に
        バンドルされず、reg-free WinRT 活性化に必要なファイルが揃わない。結果として
        Microsoft.UI.Xaml.dll が WinRT メタデータを見つけられず XAML parse で
        クラッシュする。Debug 中は従来通り Bootstrap.Initialize 経由でシステム
        インストール済みの WindowsAppRuntime を使う運用に戻し、self-contained 関連
        スイッチは Release 限定で有効化する。
    -->
    <DefineConstants Condition="'$(Configuration)' == 'Release'">$(DefineConstants);RELEASE_SELF_CONTAINED</DefineConstants>

    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
      Release 専用設定: self-contained 配布。
      - SelfContained=true: .NET 本体を publish 出力に同梱 (apphost ダイアログ排除)
      - WindowsAppSDKSelfContained=true: WinAppSDK Framework 中身を AppLocal にコピー
      - WindowsAppSdkUndockedRegFreeWinRTInitialize=true: reg-free WinRT で活性化
      - WindowsAppSdkBootstrapInitialize=false: 自動 Bootstrap を抑制 (システム MSIX
        の二重ロードを防止。手動 Bootstrap.Initialize 呼び出しも #if で外す)
      - InvariantGlobalization=true: ICU データ削減 (~30 MB)
      Debug ビルドではこれらは無効。dotnet build しかしないとバンドル DLL が
      AppLocal に置かれず XAML parse でクラッシュするため、開発時は従来通り
      Bootstrap.Initialize でシステム MSIX を使う。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\LogoText.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\avatar.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- Keep an assembly-name XBF mirror for older generated LoadComponent paths.
       Release publish also mirrors XBF files to the app root because current
       generated code uses root-relative ms-appx:/// paths. -->
  <Target Name="CopyXbfToSubfolder" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)$(AssemblyName)\$(AssemblyName)"
               Condition="Exists('$(OutDir)$(AssemblyName)\$(AssemblyName)')" />
    <ItemGroup>
      <_XbfFiles Include="$(OutDir)**\*.xbf"
                 Exclude="$(OutDir)$(AssemblyName)\**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfFiles)"
          DestinationFiles="@(_XbfFiles->'$(OutDir)$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
