<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Alpheratz</AssemblyName>
    <RootNamespace>Launcher</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\app\Core\AppConstants.cs" Link="Shared\AppConstants.cs" />
    <Compile Include="..\..\app\Messages\MessageCatalog.cs" Link="Shared\MessageCatalog.cs" />
    <EmbeddedResource Include="..\..\app\Messages\messages.ja.properties" LogicalName="Alpheratz.Messages.messages.ja.properties">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
</Project>
